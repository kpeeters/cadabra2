							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\dR = \\dR_{\\sigma \\nu} g^{\\sigma \\nu} + R_{\\sigma \\nu} \\dg^{\\sigma \\nu}"
						}
					],
					"source": "\\begin{dmath*}{}\\delta R = \\delta R_{\\sigma \\nu} g^{\\sigma \\nu}\\discretionary{}{}{}+R_{\\sigma \\nu} \\delta g^{\\sigma \\nu}\\end{dmath*}"
