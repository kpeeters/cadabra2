						{
							"cell_id": 15441969494754887214,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\dR^{\\rho}_{\\sigma \\mu \\nu} = \\partial_{\\mu}(\\dCn^{\\rho}_{\\nu \\sigma})-\\partial_{\\nu}(\\dCn^{\\rho}_{\\mu \\sigma}) + \\dCn^{\\rho}_{\\mu \\lambda} \\Gamma^{\\lambda}_{\\nu \\sigma} + \\Gamma^{\\rho}_{\\mu \\lambda} \\dCn^{\\lambda}_{\\nu \\sigma}-\\dCn^{\\rho}_{\\nu \\lambda} \\Gamma^{\\lambda}_{\\mu \\sigma}-\\Gamma^{\\rho}_{\\nu \\lambda} \\dCn^{\\lambda}_{\\mu \\sigma}"
						}
					],
					"source": "\\begin{dmath*}{}\\delta R^{\\rho}\\,_{\\sigma \\mu \\nu} = \\partial_{\\mu}{\\delta\\Gamma^{\\rho}\\,_{\\nu \\sigma}}\\discretionary{}{}{}-\\,\\partial_{\\nu}{\\delta\\Gamma^{\\rho}\\,_{\\mu \\sigma}}\\discretionary{}{}{}+\\delta\\Gamma^{\\rho}\\,_{\\mu \\lambda} \\Gamma^{\\lambda}\\,_{\\nu \\sigma}\\discretionary{}{}{}+\\Gamma^{\\rho}\\,_{\\mu \\lambda} \\delta\\Gamma^{\\lambda}\\,_{\\nu \\sigma}\\discretionary{}{}{}-\\,\\delta\\Gamma^{\\rho}\\,_{\\nu \\lambda} \\Gamma^{\\lambda}\\,_{\\mu \\sigma}\\discretionary{}{}{}-\\,\\Gamma^{\\rho}\\,_{\\nu \\lambda} \\delta\\Gamma^{\\lambda}\\,_{\\mu \\sigma}\\end{dmath*}"
				},
				{
					"cell_id": 16469404157751399445,
					"cell_origin": "server",
