					"cells": [
						{
							"cell_id": 5090094017664690546,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\delta(S) = \\int{ -  1/4 \\Dg g_{\\mu \\nu} \\dg^{\\mu \\nu} (\\kappa)**(-1) R +  1/2 \\Dg (\\kappa)**(-1) \\dR +  1/2 \\Dg g_{\\mu \\nu} \\dg^{\\mu \\nu} (\\kappa)**(-1) \\Lambda -  1/2 \\Dg g_{\\mu \\nu} \\dg^{\\mu \\nu} \\Lm + \\Dg \\delta(\\Lm)}{x}"
						}
					],
					"source": "\\begin{dmath*}{}\\delta{S} = \\int \\left( - \\frac{1}{4}\\,\\sqrt{-g} g_{\\mu \\nu} \\delta g^{\\mu \\nu} {\\kappa}^{-\\,1} R\\discretionary{}{}{}+\\frac{1}{2}\\,\\sqrt{-g} {\\kappa}^{-\\,1} \\delta R\\discretionary{}{}{}+\\frac{1}{2}\\,\\sqrt{-g} g_{\\mu \\nu} \\delta g^{\\mu \\nu} {\\kappa}^{-\\,1} \\Lambda\\discretionary{}{}{} - \\frac{1}{2}\\,\\sqrt{-g} g_{\\mu \\nu} \\delta g^{\\mu \\nu} \\mathcal{L}_{\\text{mat}}\\discretionary{}{}{}+\\sqrt{-g} \\delta{\\mathcal{L}_{\\text{mat}}}\\right)\\,\\,{\\rm d}x\\end{dmath*}"
				},
				{
					"cell_id": 13414191817483952679,
