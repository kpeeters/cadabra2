						{
							"cell_id": 4028820071498625146,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\delta(S) = \\int{ 1/2 \\delta(\\Dg) (\\kappa)**(-1) R +  1/2 \\Dg (\\kappa)**(-1) \\dR-\\delta(\\Dg) (\\kappa)**(-1) \\Lambda + \\delta(\\Dg) \\Lm + \\Dg \\delta(\\Lm)}{x}"
						}
					],
					"source": "\\begin{dmath*}{}\\delta{S} = \\int \\left(\\frac{1}{2}\\,\\delta{\\sqrt{-g}} {\\kappa}^{-\\,1} R\\discretionary{}{}{}+\\frac{1}{2}\\,\\sqrt{-g} {\\kappa}^{-\\,1} \\delta R\\discretionary{}{}{}-\\,\\delta{\\sqrt{-g}} {\\kappa}^{-\\,1} \\Lambda\\discretionary{}{}{}+\\delta{\\sqrt{-g}} \\mathcal{L}_{\\text{mat}}\\discretionary{}{}{}+\\sqrt{-g} \\delta{\\mathcal{L}_{\\text{mat}}}\\right)\\,\\,{\\rm d}x\\end{dmath*}"
				},
