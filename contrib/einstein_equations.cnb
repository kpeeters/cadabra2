							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\dR = (\\nabla_{\\rho}(\\dCn^{\\rho}_{\\nu \\sigma})-\\nabla_{\\nu}(\\dCn^{\\rho}_{\\rho \\sigma})) g^{\\sigma \\nu} + R_{\\sigma \\nu} \\dg^{\\sigma \\nu}"
						}
					],
					"source": "\\begin{dmath*}{}\\delta R = \\left(\\nabla_{\\rho}{\\delta\\Gamma^{\\rho}\\,_{\\nu \\sigma}}\\discretionary{}{}{}-\\,\\nabla_{\\nu}{\\delta\\Gamma^{\\rho}\\,_{\\rho \\sigma}}\\right) g^{\\sigma \\nu}\\discretionary{}{}{}+R_{\\sigma \\nu} \\delta g^{\\sigma \\nu}\\end{dmath*}"
