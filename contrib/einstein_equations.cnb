			"source": "\\section*{Einstein equations from a variational principle}\n\nMattia Scomparin, mattia.scompa@gmail.com"
		},
		{
			"cell_id": 6315322830311666894,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 10212236338241952679,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "This notebook derives the Einstein equations by starting from the Einstein-Hilbert action, and requiring that\nits variational derivative with respect to the metric vanishes. "
				}
			],
			"hidden": true,
			"source": "This notebook derives the Einstein equations by starting from the Einstein-Hilbert action, and requiring that\nits variational derivative with respect to the metric vanishes. "
		},
		{
			"cell_id": 13379780094689472235,
			"cell_origin": "client",
			"cell_type": "input",
			"source": "import cdb.core.manip as manip"
		},
		{
			"cell_id": 10371871863426304829,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 16410356620207418787,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "We first of all need to declare the indices which we will use, as well as the symbols we use for the metric and Kronecker delta."
				}
			],
			"hidden": true,
			"source": "We first of all need to declare the indices which we will use, as well as the symbols we use for the metric and Kronecker delta."
		},
		{
			"cell_id": 12026606434033719507,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 12613978542946535043,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"source": "\\begin{dmath*}{}\\text{Property Indices(position=independent) attached to~}\\left[\\mu, \\discretionary{}{}{}\\nu, \\discretionary{}{}{}\\rho, \\discretionary{}{}{}\\sigma, \\discretionary{}{}{}\\alpha, \\discretionary{}{}{}\\beta, \\discretionary{}{}{}\\gamma, \\discretionary{}{}{}\\lambda, \\discretionary{}{}{}\\tau, \\discretionary{}{}{}\\pi, \\discretionary{}{}{}\\xi, \\discretionary{}{}{}\\iota, \\discretionary{}{}{}\\omega, \\discretionary{}{}{}\\kappa, \\discretionary{}{}{}\\psi, \\discretionary{}{}{}\\chi, \\discretionary{}{}{}\\epsilon, \\discretionary{}{}{}\\upsilon\\right].\\end{dmath*}"
				}
			],
			"source": "{\\mu,\\nu,\\rho,\\sigma,\\alpha,\\beta,\\gamma,\\lambda,\\tau,\\pi,\\xi,\\iota,\\omega,\\kappa,\\psi,\\chi,\\epsilon,\\upsilon}::Indices(position=independent);\ng_{\\mu\\nu}::Metric.\ng^{\\mu\\nu}::InverseMetric.\n{\\delta{#},g_{\\mu}^{\\nu},g^{\\mu}_{\\nu}}::KroneckerDelta."
		},
		{
			"cell_id": 4099811768478893280,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 6983343218947391649,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "Make various symbols display in a more readable form,"
				}
			],
			"hidden": true,
			"source": "Make various symbols display in a more readable form,"
		},
		{
			"cell_id": 11642084167738648294,
			"cell_origin": "client",
			"cell_type": "input",
			"source": "\\Lm::LaTeXForm(\"\\mathcal{L}_{\\text{mat}}\").    \t\t\n\\Dg::LaTeXForm(\"\\sqrt{-g}\").          \n\\dg{#}::LaTeXForm(\"\\delta g\").  \t\t"
		},
		{
			"cell_id": 9524316488023800916,
			"cell_origin": "client",
			"cell_type": "input",
			"source": "\\dLm::LaTeXForm(\"\\delta\\mathcal{L}_{\\text{mat}}\").  \n\\d::LaTeXForm(\"\\delta\").\n\\dDg::LaTeXForm(\"\\delta\\sqrt{-g}\").   \n\\dCn{#}::LaTeXForm(\"\\delta\\Gamma\").         \n\\dR{#}::LaTeXForm(\"\\delta R\")."
		},
		{
			"cell_id": 8086675850047485100,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 11519173481457882796,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "The Christoffel symbols and their variations are symmetric in the two lower indices,"
				}
			],
			"hidden": true,
			"source": "The Christoffel symbols and their variations are symmetric in the two lower indices,"
		},
		{
			"cell_id": 8217207651301098144,
			"cell_origin": "client",
			"cell_type": "input",
			"source": "\\Gamma^{\\alpha}_{\\mu\\nu}::TableauSymmetry(shape={2}, indices={1,2}).\n\\dGamma^{\\alpha}_{\\mu\\nu}::TableauSymmetry(shape={2}, indices={1,2})."
		},
		{
			"cell_id": 7162275542686273705,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 15039636710948054100,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "We need to declare which symbols to use for derivatives,"
				}
			],
			"hidden": true,
			"source": "We need to declare which symbols to use for derivatives,"
		},
		{
			"cell_id": 8061313335209124,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 7012530321531129631,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"source": "\\begin{dmath*}{}\\text{Property PartialDerivative attached to~}\\backslash\\texttt{partial}\\{\\#\\}.\\end{dmath*}"
				},
				{
					"cell_id": 1249480935891063440,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"source": "\\begin{dmath*}{}\\text{Property Derivative attached to~}\\left[\\backslash\\texttt{nabla}\\{\\#\\}, \\discretionary{}{}{}\\backslash\\texttt{delta}\\{\\#\\}\\right].\\end{dmath*}"
				}
			],
			"source": "{\\partial{#}}::PartialDerivative;\n{\\nabla{#},\\delta{#}}::Derivative;"
		},
		{
			"cell_id": 14777572717369237596,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 11217543380261464531,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "We now need to define the Christoffel connection in terms of the metric, and the Riemann tensor in terms of the Christoffel connection,\nas well as the Ricci tensor and scalar and Einstein tensor. These are also available in a Cadabra package, but for clarity we spell\nthem out here."
				}
			],
			"hidden": true,
			"source": "We now need to define the Christoffel connection in terms of the metric, and the Riemann tensor in terms of the Christoffel connection,\nas well as the Ricci tensor and scalar and Einstein tensor. These are also available in a Cadabra package, but for clarity we spell\nthem out here."
		},
		{
			"cell_id": 4221425492961275722,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 17541531019535213931,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 17363924299258797401,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\Gamma^{\\mu}_{\\nu \\rho} =  1/2 g^{\\mu \\sigma} (\\partial_{\\rho}(g_{\\nu \\sigma}) + \\partial_{\\nu}(g_{\\rho \\sigma})-\\partial_{\\sigma}(g_{\\nu \\rho}))"
						}
					],
					"source": "\\begin{dmath*}{}\\Gamma^{\\mu}\\,_{\\nu \\rho} = \\frac{1}{2}\\,g^{\\mu \\sigma} \\left(\\partial_{\\rho}{g_{\\nu \\sigma}}\\discretionary{}{}{}+\\partial_{\\nu}{g_{\\rho \\sigma}}\\discretionary{}{}{}-\\,\\partial_{\\sigma}{g_{\\nu \\rho}}\\right)\\end{dmath*}"
				},
				{
					"cell_id": 10410707690083323253,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 7874475004343043867,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "R^{\\rho}_{\\sigma \\mu \\nu} = \\partial_{\\mu}(\\Gamma^{\\rho}_{\\nu \\sigma})-\\partial_{\\nu}(\\Gamma^{\\rho}_{\\mu \\sigma}) + \\Gamma^{\\rho}_{\\mu \\lambda} \\Gamma^{\\lambda}_{\\nu \\sigma}-\\Gamma^{\\rho}_{\\nu \\lambda} \\Gamma^{\\lambda}_{\\mu \\sigma}"
						}
					],
					"source": "\\begin{dmath*}{}R^{\\rho}\\,_{\\sigma \\mu \\nu} = \\partial_{\\mu}{\\Gamma^{\\rho}\\,_{\\nu \\sigma}}\\discretionary{}{}{}-\\,\\partial_{\\nu}{\\Gamma^{\\rho}\\,_{\\mu \\sigma}}\\discretionary{}{}{}+\\Gamma^{\\rho}\\,_{\\mu \\lambda} \\Gamma^{\\lambda}\\,_{\\nu \\sigma}\\discretionary{}{}{}-\\,\\Gamma^{\\rho}\\,_{\\nu \\lambda} \\Gamma^{\\lambda}\\,_{\\mu \\sigma}\\end{dmath*}"
				},
				{
					"cell_id": 6016529293278648589,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 3720647862232228780,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "R_{\\sigma \\nu} = R^{\\rho}_{\\sigma \\rho \\nu}"
						}
					],
					"source": "\\begin{dmath*}{}R_{\\sigma \\nu} = R^{\\rho}\\,_{\\sigma \\rho \\nu}\\end{dmath*}"
				},
				{
					"cell_id": 16439131283091793177,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 15832841361320220193,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "R = R_{\\sigma \\nu} g^{\\sigma \\nu}"
						}
					],
					"source": "\\begin{dmath*}{}R = R_{\\sigma \\nu} g^{\\sigma \\nu}\\end{dmath*}"
				},
				{
					"cell_id": 5185302121213743653,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 11030986720516135657,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "G_{\\mu \\nu} = R_{\\mu \\nu} -  1/2 g_{\\mu \\nu} R"
						}
					],
					"source": "\\begin{dmath*}{}G_{\\mu \\nu} = R_{\\mu \\nu}\\discretionary{}{}{} - \\frac{1}{2}\\,g_{\\mu \\nu} R\\end{dmath*}"
				}
			],
			"source": "connection       := \\Gamma^{\\mu}_{\\nu\\rho} = 1/2 g^{\\mu\\sigma} ( \\partial_{\\rho}{g_{\\nu\\sigma}} +\\partial_{\\nu}{g_{\\rho\\sigma}} -\\partial_{\\sigma}{g_{\\nu\\rho}} );\nriemannTensor    := R^{\\rho}_{\\sigma\\mu\\nu} = \\partial_{\\mu}{\\Gamma^{\\rho}_{\\nu\\sigma}} -\\partial_{\\nu}{\\Gamma^{\\rho}_{\\mu\\sigma}} \n                                              +\\Gamma^{\\rho}_{\\mu\\lambda} \\Gamma^{\\lambda}_{\\nu\\sigma} -\\Gamma^{\\rho}_{\\nu\\lambda} \\Gamma^{\\lambda}_{\\mu\\sigma};\nricciTensor      := R_{\\sigma\\nu} = R^{\\rho}_{\\sigma\\rho\\nu};\nscalarCurvature  := R = R_{\\sigma\\nu} g^{\\sigma\\nu};      \neinsteinTensor   := G_{\\mu\\nu} = R_{\\mu\\nu} - 1/2 g_{\\mu\\nu} R;"
		},
		{
			"cell_id": 3588601654044716157,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 16619270810956890743,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "We are now ready to address the variational problem. The action we use is the Einstein-Hilbert action, amended with \na cosmological constant term."
				}
			],
			"hidden": true,
			"source": "We are now ready to address the variational problem. The action we use is the Einstein-Hilbert action, amended with \na cosmological constant term."
		},
		{
			"cell_id": 18348232484081575245,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 6301759406200254291,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 3219437326564106413,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "S = \\int{\\Dg ( 1/2 (\\kappa)**(-1) (R-2\\Lambda) + \\Lm)}{x}"
						}
					],
					"source": "\\begin{dmath*}{}S = \\int \\sqrt{-g} \\left(\\frac{1}{2}\\,{\\kappa}^{-\\,1} \\left(R\\discretionary{}{}{}-2\\,\\Lambda\\right)\\discretionary{}{}{}+\\mathcal{L}_{\\text{mat}}\\right)\\,\\,{\\rm d}x\\end{dmath*}"
				},
				{
					"cell_id": 13184848917237412182,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 13383736749393762656,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "S = \\int{ 1/2 \\Dg (\\kappa)**(-1) R-\\Dg (\\kappa)**(-1) \\Lambda + \\Dg \\Lm}{x}"
						}
					],
					"source": "\\begin{dmath*}{}S = \\int \\left(\\frac{1}{2}\\,\\sqrt{-g} {\\kappa}^{-\\,1} R\\discretionary{}{}{}-\\,\\sqrt{-g} {\\kappa}^{-\\,1} \\Lambda\\discretionary{}{}{}+\\sqrt{-g} \\mathcal{L}_{\\text{mat}}\\right)\\,\\,{\\rm d}x\\end{dmath*}"
				}
			],
			"source": "action := S = \\int{\\Dg*[1/2*1/\\kappa*(R-2\\Lambda)+\\Lm]}{x};\ndistribute(_);"
		},
		{
			"cell_id": 14115085376441685767,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 14704082240938825405,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "Before we vary this, we need to construct the variation of the various objects in this action step by step. The variation of the metric determinant is given by"
				}
			],
			"hidden": true,
			"source": "Before we vary this, we need to construct the variation of the various objects in this action step by step. The variation of the metric determinant is given by"
		},
		{
			"cell_id": 12976228545462908118,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 6305117467675604970,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 14225819632602079796,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\delta(\\Dg) =  -  1/2 \\Dg g_{\\mu \\nu} \\dg^{\\mu \\nu}"
						}
					],
					"source": "\\begin{dmath*}{}\\delta{\\sqrt{-g}} =  - \\frac{1}{2}\\,\\sqrt{-g} g_{\\mu \\nu} \\delta g^{\\mu \\nu}\\end{dmath*}"
				}
			],
			"source": "deltaMetricDeterminant := \\delta(\\Dg) = -\\frac{1}{2}*\\Dg*g_{\\mu\\nu}\\dg^{\\mu\\nu}; "
		},
		{
			"cell_id": 7802145286405783782,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 12993996851364355983,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "By definition the variation of the matter Lagrangian gives the stress tensor; we rewrite it here slightly for later purposes."
				}
			],
			"hidden": true,
			"source": "By definition the variation of the matter Lagrangian gives the stress tensor; we rewrite it here slightly for later purposes."
		},
		{
			"cell_id": 11784529878310424927,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 13404954297301563396,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 12945057887878553680,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\Dg T_{\\mu \\nu} \\dg^{\\mu \\nu} = -2\\delta(\\Dg \\Lm)"
						}
					],
					"source": "\\begin{dmath*}{}\\sqrt{-g} T_{\\mu \\nu} \\delta g^{\\mu \\nu} = -2\\,\\delta\\left(\\sqrt{-g} \\mathcal{L}_{\\text{mat}}\\right)\\end{dmath*}"
				},
				{
					"cell_id": 5997197618091789307,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 6025629104962505255,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\Dg g_{\\mu \\nu} \\dg^{\\mu \\nu} \\Lm-2\\Dg \\delta(\\Lm) = \\Dg T_{\\mu \\nu} \\dg^{\\mu \\nu}"
						}
					],
					"source": "\\begin{dmath*}{}\\sqrt{-g} g_{\\mu \\nu} \\delta g^{\\mu \\nu} \\mathcal{L}_{\\text{mat}}\\discretionary{}{}{}-2\\,\\sqrt{-g} \\delta{\\mathcal{L}_{\\text{mat}}} = \\sqrt{-g} T_{\\mu \\nu} \\delta g^{\\mu \\nu}\\end{dmath*}"
				}
			],
			"source": "energyMomentumTensor := \\Dg T_{\\mu\\nu}\\dg^{\\mu\\nu} = -2\\delta(\\Dg*\\Lm);\nproduct_rule(_)\ndistribute(_)\nsubstitute(_,deltaMetricDeterminant)\nmatterLagrangianVariation = manip.swap_sides(_);"
		},
		{
			"cell_id": 5705771889462518163,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 4686252733273322228,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "Next comes the variation of the Christoffel symbols. We then rewrite these in such a way that we isolate the derivative\nof the variation, as that object will appear once we start varying the Riemann tensor."
				}
			],
			"hidden": true,
			"source": "Next comes the variation of the Christoffel symbols. We then rewrite these in such a way that we isolate the derivative\nof the variation, as that object will appear once we start varying the Riemann tensor."
		},
		{
			"cell_id": 8332899569772598841,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 7962794284272902868,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 1630484979854464967,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\nabla_{\\sigma}(\\dCn^{\\mu}_{\\nu \\rho}) = \\partial_{\\sigma}(\\dCn^{\\mu}_{\\nu \\rho}) + \\Gamma^{\\mu}_{\\sigma \\alpha} \\dCn^{\\alpha}_{\\nu \\rho}-\\Gamma^{\\alpha}_{\\sigma \\nu} \\dCn^{\\mu}_{\\alpha \\rho}-\\Gamma^{\\alpha}_{\\sigma \\rho} \\dCn^{\\mu}_{\\nu \\alpha}"
						}
					],
					"source": "\\begin{dmath*}{}\\nabla_{\\sigma}{\\delta\\Gamma^{\\mu}\\,_{\\nu \\rho}} = \\partial_{\\sigma}{\\delta\\Gamma^{\\mu}\\,_{\\nu \\rho}}\\discretionary{}{}{}+\\Gamma^{\\mu}\\,_{\\sigma \\alpha} \\delta\\Gamma^{\\alpha}\\,_{\\nu \\rho}\\discretionary{}{}{}-\\,\\Gamma^{\\alpha}\\,_{\\sigma \\nu} \\delta\\Gamma^{\\mu}\\,_{\\alpha \\rho}\\discretionary{}{}{}-\\,\\Gamma^{\\alpha}\\,_{\\sigma \\rho} \\delta\\Gamma^{\\mu}\\,_{\\nu \\alpha}\\end{dmath*}"
				},
				{
					"cell_id": 2194606843382872529,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 2566407337043857645,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "0 = \\partial_{\\sigma}(\\dCn^{\\mu}_{\\nu \\rho}) + \\Gamma^{\\mu}_{\\sigma \\alpha} \\dCn^{\\alpha}_{\\nu \\rho}-\\Gamma^{\\alpha}_{\\sigma \\nu} \\dCn^{\\mu}_{\\alpha \\rho}-\\Gamma^{\\alpha}_{\\sigma \\rho} \\dCn^{\\mu}_{\\nu \\alpha}-\\nabla_{\\sigma}(\\dCn^{\\mu}_{\\nu \\rho})"
						}
					],
					"source": "\\begin{dmath*}{}0\\, = \\partial_{\\sigma}{\\delta\\Gamma^{\\mu}\\,_{\\nu \\rho}}\\discretionary{}{}{}+\\Gamma^{\\mu}\\,_{\\sigma \\alpha} \\delta\\Gamma^{\\alpha}\\,_{\\nu \\rho}\\discretionary{}{}{}-\\,\\Gamma^{\\alpha}\\,_{\\sigma \\nu} \\delta\\Gamma^{\\mu}\\,_{\\alpha \\rho}\\discretionary{}{}{}-\\,\\Gamma^{\\alpha}\\,_{\\sigma \\rho} \\delta\\Gamma^{\\mu}\\,_{\\nu \\alpha}\\discretionary{}{}{}-\\,\\nabla_{\\sigma}{\\delta\\Gamma^{\\mu}\\,_{\\nu \\rho}}\\end{dmath*}"
				},
				{
					"cell_id": 10490588020953705726,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 855237232770608214,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "-\\partial_{\\sigma}(\\dCn^{\\mu}_{\\nu \\rho}) = \\Gamma^{\\mu}_{\\sigma \\alpha} \\dCn^{\\alpha}_{\\nu \\rho}-\\Gamma^{\\alpha}_{\\sigma \\nu} \\dCn^{\\mu}_{\\alpha \\rho}-\\Gamma^{\\alpha}_{\\sigma \\rho} \\dCn^{\\mu}_{\\nu \\alpha}-\\nabla_{\\sigma}(\\dCn^{\\mu}_{\\nu \\rho})"
						}
					],
					"source": "\\begin{dmath*}{}-\\,\\partial_{\\sigma}{\\delta\\Gamma^{\\mu}\\,_{\\nu \\rho}} = \\Gamma^{\\mu}\\,_{\\sigma \\alpha} \\delta\\Gamma^{\\alpha}\\,_{\\nu \\rho}\\discretionary{}{}{}-\\,\\Gamma^{\\alpha}\\,_{\\sigma \\nu} \\delta\\Gamma^{\\mu}\\,_{\\alpha \\rho}\\discretionary{}{}{}-\\,\\Gamma^{\\alpha}\\,_{\\sigma \\rho} \\delta\\Gamma^{\\mu}\\,_{\\nu \\alpha}\\discretionary{}{}{}-\\,\\nabla_{\\sigma}{\\delta\\Gamma^{\\mu}\\,_{\\nu \\rho}}\\end{dmath*}"
				},
				{
					"cell_id": 4888331180760944016,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 13354494445396230297,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\partial_{\\sigma}(\\dCn^{\\mu}_{\\nu \\rho}) = -\\Gamma^{\\mu}_{\\sigma \\alpha} \\dCn^{\\alpha}_{\\nu \\rho} + \\Gamma^{\\alpha}_{\\sigma \\nu} \\dCn^{\\mu}_{\\alpha \\rho} + \\Gamma^{\\alpha}_{\\sigma \\rho} \\dCn^{\\mu}_{\\nu \\alpha} + \\nabla_{\\sigma}(\\dCn^{\\mu}_{\\nu \\rho})"
						}
					],
					"source": "\\begin{dmath*}{}\\partial_{\\sigma}{\\delta\\Gamma^{\\mu}\\,_{\\nu \\rho}} = -\\,\\Gamma^{\\mu}\\,_{\\sigma \\alpha} \\delta\\Gamma^{\\alpha}\\,_{\\nu \\rho}\\discretionary{}{}{}+\\Gamma^{\\alpha}\\,_{\\sigma \\nu} \\delta\\Gamma^{\\mu}\\,_{\\alpha \\rho}\\discretionary{}{}{}+\\Gamma^{\\alpha}\\,_{\\sigma \\rho} \\delta\\Gamma^{\\mu}\\,_{\\nu \\alpha}\\discretionary{}{}{}+\\nabla_{\\sigma}{\\delta\\Gamma^{\\mu}\\,_{\\nu \\rho}}\\end{dmath*}"
				}
			],
			"source": "covariantDerivativeCn := \\nabla_{\\sigma}(\\dCn^{\\mu}_{\\nu\\rho}) = \\partial_{\\sigma}(\\dCn^{\\mu}_{\\nu\\rho})\n                        +\\Gamma^{\\mu}_{\\sigma\\alpha}\\dCn^{\\alpha}_{\\nu\\rho}-\\Gamma^{\\alpha}_{\\sigma\\nu}\\dCn^{\\mu}_{\\alpha\\rho}\n                        -\\Gamma^{\\alpha}_{\\sigma\\rho}\\dCn^{\\mu}_{\\nu\\alpha}; \ncovariantDerivativeCn1 = manip.to_rhs(_, $\\nabla_{\\sigma}{A??}$);\ncovariantDerivativeCn2 = manip.to_lhs(_, $\\partial_{\\sigma}{A??}$);\npartialDerivativeCn = manip.multiply_through(covariantDerivativeCn2, $-1$);"
		},
		{
			"cell_id": 16682970839863252489,
