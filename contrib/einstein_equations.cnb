							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\dR^{\\rho}_{\\sigma \\mu \\nu} = \\partial_{\\mu}(\\dCn^{\\rho}_{\\nu \\sigma})-\\partial_{\\nu}(\\dCn^{\\rho}_{\\mu \\sigma}) + \\Gamma^{\\lambda}_{\\nu \\sigma} \\dCn^{\\rho}_{\\mu \\lambda} + \\Gamma^{\\rho}_{\\mu \\lambda} \\dCn^{\\lambda}_{\\nu \\sigma}-\\Gamma^{\\lambda}_{\\mu \\sigma} \\dCn^{\\rho}_{\\nu \\lambda}-\\Gamma^{\\rho}_{\\nu \\lambda} \\dCn^{\\lambda}_{\\mu \\sigma}"
						}
					],
					"source": "\\begin{dmath*}{}\\delta R^{\\rho}\\,_{\\sigma \\mu \\nu} = \\partial_{\\mu}{\\delta\\Gamma^{\\rho}\\,_{\\nu \\sigma}}\\discretionary{}{}{}-\\,\\partial_{\\nu}{\\delta\\Gamma^{\\rho}\\,_{\\mu \\sigma}}\\discretionary{}{}{}+\\Gamma^{\\lambda}\\,_{\\nu \\sigma} \\delta\\Gamma^{\\rho}\\,_{\\mu \\lambda}\\discretionary{}{}{}+\\Gamma^{\\rho}\\,_{\\mu \\lambda} \\delta\\Gamma^{\\lambda}\\,_{\\nu \\sigma}\\discretionary{}{}{}-\\,\\Gamma^{\\lambda}\\,_{\\mu \\sigma} \\delta\\Gamma^{\\rho}\\,_{\\nu \\lambda}\\discretionary{}{}{}-\\,\\Gamma^{\\rho}\\,_{\\nu \\lambda} \\delta\\Gamma^{\\lambda}\\,_{\\mu \\sigma}\\end{dmath*}"
				},
				{
					"cell_id": 15936506893807300807,
					"cell_origin": "server",
