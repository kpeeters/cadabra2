					"cells": [
						{
							"cell_id": 9892642246417378143,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\dR_{\\sigma \\nu} = \\dR^{\\rho}_{\\sigma \\rho \\nu}"
						}
					],
					"source": "\\begin{dmath*}{}\\delta R_{\\sigma \\nu} = \\delta R^{\\rho}\\,_{\\sigma \\rho \\nu}\\end{dmath*}"
