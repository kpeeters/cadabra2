							"cell_type": "input_form",
							"source": "\\dR = \\nabla_{\\rho}(\\dCn^{\\rho}_{\\nu \\sigma}) g^{\\sigma \\nu}-\\nabla_{\\nu}(\\dCn^{\\rho}_{\\rho \\sigma}) g^{\\sigma \\nu} + R_{\\sigma \\nu} \\dg^{\\sigma \\nu}"
						}
					],
					"source": "\\begin{dmath*}{}\\delta R = \\nabla_{\\rho}{\\delta\\Gamma^{\\rho}\\,_{\\nu \\sigma}} g^{\\sigma \\nu}\\discretionary{}{}{}-\\,\\nabla_{\\nu}{\\delta\\Gamma^{\\rho}\\,_{\\rho \\sigma}} g^{\\sigma \\nu}\\discretionary{}{}{}+R_{\\sigma \\nu} \\delta g^{\\sigma \\nu}\\end{dmath*}"
				},
