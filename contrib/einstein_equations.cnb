					"cells": [
						{
							"cell_id": 11182277955834853415,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\dR^{\\rho}_{\\sigma \\mu \\nu} = \\Gamma^{\\alpha}_{\\mu \\nu} \\dCn^{\\rho}_{\\alpha \\sigma} + \\nabla_{\\mu}(\\dCn^{\\rho}_{\\nu \\sigma})-\\Gamma^{\\alpha}_{\\nu \\mu} \\dCn^{\\rho}_{\\alpha \\sigma}-\\nabla_{\\nu}(\\dCn^{\\rho}_{\\mu \\sigma})"
						}
					],
					"source": "\\begin{dmath*}{}\\delta R^{\\rho}\\,_{\\sigma \\mu \\nu} = \\Gamma^{\\alpha}\\,_{\\mu \\nu} \\delta\\Gamma^{\\rho}\\,_{\\alpha \\sigma}\\discretionary{}{}{}+\\nabla_{\\mu}{\\delta\\Gamma^{\\rho}\\,_{\\nu \\sigma}}\\discretionary{}{}{}-\\,\\Gamma^{\\alpha}\\,_{\\nu \\mu} \\delta\\Gamma^{\\rho}\\,_{\\alpha \\sigma}\\discretionary{}{}{}-\\,\\nabla_{\\nu}{\\delta\\Gamma^{\\rho}\\,_{\\mu \\sigma}}\\end{dmath*}"
