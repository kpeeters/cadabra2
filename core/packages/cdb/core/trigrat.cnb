						}
					],
					"source": "\\begin{dmath*}{}{\\left(\\sin{x} \\cos{x}\\right)}^{-\\,1}\\end{dmath*}"
				}
			],
			"ignore_on_import": true,
			"source": "trigrat($\\tan(x) + 1/\\tan(x)$);"
		},
		{
			"cell_id": 7444151390257445157,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 3408272803871843536,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "Denominators are made free of sines, so the following is rewritten:"
				}
			],
			"hidden": true,
			"source": "Denominators are made free of sines, so the following is rewritten:"
		},
		{
			"cell_id": 8099763812441902501,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 657219005897329957,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 12364166823973061094,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "(1-\\sin(x)) (\\cos(x))**(-2)"
						}
					],
					"source": "\\begin{dmath*}{}\\left(1\\discretionary{}{}{}-\\,\\sin{x}\\right) {\\left(\\cos{x}\\right)}^{-2\\,}\\end{dmath*}"
				}
			],
			"ignore_on_import": true,
			"source": "trigrat($1/(1+\\sin(x))$);"
		},
		{
			"cell_id": 8488681285142299656,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 4411267033706691625,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "A typical use is the simplification of tensor components. Below are the\nChristoffel symbols of a sphere of radius $R$. Switching off the built-in\nsimplification of \\algo{evaluate} and calling \\verb|trigrat| afterwards is\noften much faster than the default simplification."
				}
			],
			"hidden": true,
			"source": "A typical use is the simplification of tensor components. Below are the\nChristoffel symbols of a sphere of radius $R$. Switching off the built-in\nsimplification of \\algo{evaluate} and calling \\verb|trigrat| afterwards is\noften much faster than the default simplification."
		},
		{
			"cell_id": 4873686569147346344,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 10505527243537083921,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"source": "\\begin{dmath*}{}\\text{Property Coordinate attached to~}\\left[\\theta, \\discretionary{}{}{}\\phi\\right].\\end{dmath*}"
				},
				{
					"cell_id": 15522486531555746859,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"source": "\\begin{dmath*}{}\\text{Property Indices(position=fixed, values=\\{{\\theta}\n, {\\phi}\n\\}) attached to~}\\left[a, \\discretionary{}{}{}b, \\discretionary{}{}{}c, \\discretionary{}{}{}d\\right].\\end{dmath*}"
				},
				{
					"cell_id": 5609147394350783587,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"source": "\\begin{dmath*}{}\\text{Property PartialDerivative attached to~}\\backslash\\texttt{partial}\\{\\#\\}.\\end{dmath*}"
				}
			],
			"ignore_on_import": true,
			"source": "{\\theta,\\phi}::Coordinate;\n{a,b,c,d}::Indices(values={\\theta,\\phi}, position=fixed);\n\\partial{#}::PartialDerivative;\ng_{a b}::Metric.\ng^{a b}::InverseMetric."
		},
		{
			"cell_id": 6161270763981700860,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 10323536899784120343,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 360044091399685662,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "{g_{\\theta \\theta} = (R)**2, g_{\\phi \\phi} = (R)**2 (\\sin(\\theta))**2, g^{\\theta \\theta} = (R)**(-2), g^{\\phi \\phi} = ((R)**2 (\\sin(\\theta))**2)**(-1)}"
						}
					],
					"source": "\\begin{dmath*}{}\\left[g_{\\theta \\theta} = {R}^{2\\,}, \\discretionary{}{}{}g_{\\phi \\phi} = {R}^{2\\,} {\\left(\\sin{\\theta}\\right)}^{2\\,}, \\discretionary{}{}{}g^{\\theta \\theta} = {R}^{-2\\,}, \\discretionary{}{}{}g^{\\phi \\phi} = {\\left({R}^{2\\,} {\\left(\\sin{\\theta}\\right)}^{2\\,}\\right)}^{-\\,1}\\right]\\end{dmath*}"
				}
			],
			"ignore_on_import": true,
			"source": "sph:= { g_{\\theta\\theta} = R**2, g_{\\phi\\phi} = R**2 \\sin(\\theta)**2 }.\ncomplete(sph, $g^{a b}$);"
		},
		{
			"cell_id": 7447026327600228357,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 14241310995050564543,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 17742683222426422360,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\Gamma^{a}_{b c} =  1/2 g^{a d} (\\partial_{c}(g_{b d}) + \\partial_{b}(g_{c d})-\\partial_{d}(g_{b c}))"
						}
					],
					"source": "\\begin{dmath*}{}\\Gamma^{a}\\,_{b c} = \\frac{1}{2}\\,g^{a d} \\left(\\partial_{c}{g_{b d}}\\discretionary{}{}{}+\\partial_{b}{g_{c d}}\\discretionary{}{}{}-\\,\\partial_{d}{g_{b c}}\\right)\\end{dmath*}"
				},
				{
					"cell_id": 1983102318235674202,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 9679665477192387697,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\Gamma^{a}_{b c} = \\components_{b c}^{a}({{\\phi, \\theta, \\phi} = \\cos(\\theta) (\\sin(\\theta))**(-1), {\\theta, \\phi, \\phi} = \\cos(\\theta) (\\sin(\\theta))**(-1), {\\phi, \\phi, \\theta} = -\\sin(\\theta) \\cos(\\theta)})"
						}
					],
					"source": "\\begin{dmath*}{}\\Gamma^{a}\\,_{b c} = \\square{}_{b}{}_{c}{}^{a}\\left\\{\\begin{aligned}\\square{}_{\\phi}{}_{\\theta}{}^{\\phi}& = \\square{}_{\\theta}{}_{\\phi}{}^{\\phi} = \\cos{\\theta} {\\left(\\sin{\\theta}\\right)}^{-\\,1}\\\\[-.5ex]\n\\square{}_{\\phi}{}_{\\phi}{}^{\\theta}& = -\\,\\sin{\\theta} \\cos{\\theta}\\\\[-.5ex]\n\\end{aligned}\\right\\}\n\\end{dmath*}"
				}
			],
			"ignore_on_import": true,
			"source": "ch:= \\Gamma^{a}_{b c} = 1/2 g^{a d} ( \\partial_{c}{g_{b d}}\n                                     +\\partial_{b}{g_{c d}}\n                                     -\\partial_{d}{g_{b c}} ):\nevaluate(ch, sph, rhsonly=True, simplify=False)\ntrigrat(ch);"
		},
		{
			"cell_id": 1093602419145125321,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 6736271716914452437,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "Alternatively, \\verb|trigrat| can be used for the simplification steps\ninside \\algo{evaluate}:"
				}
			],
			"hidden": true,
			"source": "Alternatively, \\verb|trigrat| can be used for the simplification steps\ninside \\algo{evaluate}:"
		},
		{
			"cell_id": 952871291568821846,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 11557083223221252764,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 5623463260917145690,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\Gamma^{a}_{b c} =  1/2 g^{a d} (\\partial_{c}(g_{b d}) + \\partial_{b}(g_{c d})-\\partial_{d}(g_{b c}))"
						}
					],
					"source": "\\begin{dmath*}{}\\Gamma^{a}\\,_{b c} = \\frac{1}{2}\\,g^{a d} \\left(\\partial_{c}{g_{b d}}\\discretionary{}{}{}+\\partial_{b}{g_{c d}}\\discretionary{}{}{}-\\,\\partial_{d}{g_{b c}}\\right)\\end{dmath*}"
				},
				{
					"cell_id": 15047340125565857196,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 5294793388143551281,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\Gamma^{a}_{b c} = \\components_{b c}^{a}({{\\phi, \\theta, \\phi} = \\cos(\\theta) (\\sin(\\theta))**(-1), {\\theta, \\phi, \\phi} = \\cos(\\theta) (\\sin(\\theta))**(-1), {\\phi, \\phi, \\theta} = -\\sin(\\theta) \\cos(\\theta)})"
						}
					],
					"source": "\\begin{dmath*}{}\\Gamma^{a}\\,_{b c} = \\square{}_{b}{}_{c}{}^{a}\\left\\{\\begin{aligned}\\square{}_{\\phi}{}_{\\theta}{}^{\\phi}& = \\square{}_{\\theta}{}_{\\phi}{}^{\\phi} = \\cos{\\theta} {\\left(\\sin{\\theta}\\right)}^{-\\,1}\\\\[-.5ex]\n\\square{}_{\\phi}{}_{\\phi}{}^{\\theta}& = -\\,\\sin{\\theta} \\cos{\\theta}\\\\[-.5ex]\n\\end{aligned}\\right\\}\n\\end{dmath*}"
				}
			],
			"ignore_on_import": true,
			"source": "ch2:= \\Gamma^{a}_{b c} = 1/2 g^{a d} ( \\partial_{c}{g_{b d}}\n                                      +\\partial_{b}{g_{c d}}\n                                      -\\partial_{d}{g_{b c}} ):\nevaluate(ch2, sph, rhsonly=True, simplify=\"trigrat\");"
		},
		{
			"cell_id": 8944912593181026980,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 8770850141358915459,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "\\algorithm{trigrat_sympy(expr) -> sympy expression}{Canonical form of a Sympy expression in sines and cosines.}"
				}
			],
			"hidden": true,
			"source": "\\algorithm{trigrat_sympy(expr) -> sympy expression}{Canonical form of a Sympy expression in sines and cosines.}"
		},
		{
			"cell_id": 8809328353509863265,
			"cell_origin": "client",
			"cell_type": "input",
			"source": "import sympy\n\n_RECIPROCAL = {\n    sympy.tan: lambda u: sympy.sin(u)/sympy.cos(u),\n    sympy.cot: lambda u: sympy.cos(u)/sympy.sin(u),\n    sympy.sec: lambda u: 1/sympy.cos(u),\n    sympy.csc: lambda u: 1/sympy.sin(u),\n}\n\ndef _to_sin_cos(e):\n    for f, rep in _RECIPROCAL.items():\n        e = e.replace(f, rep)\n    return e\n\ndef _hide_opaque(e, table):\n    # Subexpressions which are not rational in sin and cos (other\n    # functions, non-integer powers) are treated as opaque symbols, after\n    # bringing their arguments into canonical form.\n    if e.is_Atom or isinstance(e, (sympy.sin, sympy.cos)):\n        return e\n    if isinstance(e, (sympy.Add, sympy.Mul)):\n        return e.func(*[_hide_opaque(a, table) for a in e.args])\n    if isinstance(e, sympy.Pow) and e.exp.is_Integer:\n        return sympy.Pow(_hide_opaque(e.base, table), e.exp)\n    inner = e.func(*[trigrat_sympy(a) for a in e.args])\n    if inner.is_number or inner.is_Atom or not inner.has(sympy.sin, sympy.cos):\n        return inner\n    table[inner] = None\n    return inner\n\ndef _angle_groups(angles):\n    # Angles q*t with rational q are grouped by t; within a group all\n    # angles are integer multiples of the base angle t/L.\n    groups = {}\n    for a in angles:\n        q, t = a.as_coeff_Mul()\n        if not q.is_Rational:\n            q, t = sympy.Integer(1), a\n        groups.setdefault(t, set()).add(q)\n    out = []\n    for t in sorted(groups, key=sympy.default_sort_key):\n        L = 1\n        for q in groups[t]:\n            L = sympy.ilcm(L, q.q)\n        out.append((t, sympy.Integer(L), groups[t]))\n    return out\n\ndef _reduce(p, svars, cvars):\n    # Reduce a polynomial modulo s_k**2 + c_k**2 - 1, leaving it of\n    # degree at most one in each s_k.\n    p = sympy.expand(p)\n    if not svars or p == 0:\n        return p\n    out = []\n    for mon, coeff in sympy.Poly(p, *svars).terms():\n        term = coeff\n        for e, s, c in zip(mon, svars, cvars):\n            term *= (1 - c**2)**(e // 2) * s**(e % 2)\n        out.append(term)\n    return sympy.expand(sympy.Add(*out))\n\ndef _pretty(p, svars, cvars):\n    # Factor p, writing factors c_k**2 - 1 as -s_k**2. This is a fixed\n    # function of p, so the result stays unique.\n    pre = sympy.Integer(1)\n    for s, c in zip(svars, cvars):\n        if not p.has(c):\n            continue\n        rel = sympy.Poly(c**2 - 1, c)\n        while True:\n            q, r = sympy.div(sympy.Poly(p, c), rel)\n            if not r.is_zero:\n                break\n            p = q.as_expr()\n            pre *= -s**2\n    return pre * sympy.factor(p)\n\ndef trigrat_sympy(expr):\n    \"\"\"Canonical form of a rational function of sines and cosines (and\n    tan, cot, sec, csc) of any number of angles.\"\"\"\n    e = _to_sin_cos(sympy.sympify(expr))\n    if not e.has(sympy.sin, sympy.cos):\n        return sympy.factor(sympy.cancel(e))\n\n    table = {}\n    e = _hide_opaque(e, table)\n    hidden = sorted(table, key=sympy.default_sort_key)\n    hsyms = [sympy.Symbol('_trigrat_h%d' % i) for i in range(len(hidden))]\n    e = e.xreplace(dict(zip(hidden, hsyms)))\n\n    e = sympy.expand_trig(e)\n    angles = {f.args[0] for f in e.atoms(sympy.sin, sympy.cos)}\n    groups = _angle_groups(angles)\n    svars = [sympy.Symbol('_trigrat_s%d' % k) for k in range(len(groups))]\n    cvars = [sympy.Symbol('_trigrat_c%d' % k) for k in range(len(groups))]\n    u = sympy.Dummy('u')\n    rep, bases = {}, []\n    for (t, L, qs), s, c in zip(groups, svars, cvars):\n        bases.append(t / L)\n        for q in qs:\n            for f in (sympy.sin, sympy.cos):\n                rep[f(q * t)] = sympy.expand_trig(f(q * L * u)).xreplace(\n                    {sympy.sin(u): s, sympy.cos(u): c})\n    e = e.xreplace(rep)\n\n    n, d = sympy.fraction(sympy.together(e))\n    n, d = _reduce(n, svars, cvars), _reduce(d, svars, cvars)\n    for s, c in zip(svars, cvars):\n        d0, d1 = d.coeff(s, 0), d.coeff(s, 1)\n        if d1 != 0:\n            n = _reduce(n * (d0 - d1 * s), svars, cvars)\n            d = _reduce(d0**2 - d1**2 * (1 - c**2), svars, cvars)\n    if n == 0:\n        return sympy.Integer(0)\n\n    terms = sympy.Poly(n, *svars).terms() if svars else [((), n)]\n    coeffs = [cf for _, cf in terms]\n    g = sympy.gcd_list(coeffs + [d])\n    coeffs = [sympy.cancel(cf / g) for cf in coeffs]\n    d = sympy.cancel(d / g)\n    gens = sorted(d.free_symbols, key=sympy.default_sort_key)\n    # Fix the overall sign: denominator with more positive than negative\n    # coefficients, or a positive leading coefficient in case of a tie.\n    dc = sympy.Poly(d, *gens).coeffs() if gens else [d]\n    neg = sum(1 for k in dc if k < 0)\n    if 2 * neg > len(dc) or (2 * neg == len(dc) and dc[0] < 0):\n        coeffs, d = [-cf for cf in coeffs], -d\n    num = sympy.Add(*[_pretty(cf, svars, cvars)\n                      * sympy.Mul(*[s**k for s, k in zip(svars, mon)])\n                      for (mon, _), cf in zip(terms, coeffs)])\n    res = num / _pretty(d, svars, cvars)\n\n    back = dict(zip(hsyms, hidden))\n    for s, c, b in zip(svars, cvars, bases):\n        back[s], back[c] = sympy.sin(b), sympy.cos(b)\n    return res.xreplace(back)\n\n# Make the function available by name to map_sympy and evaluate.\nsympy.trigrat = trigrat_sympy\nif 'trigrat' not in sympy.__all__:\n    sympy.__all__.append('trigrat')\n\n__all__ = ['trigrat', 'trigrat_sympy']"
		},
