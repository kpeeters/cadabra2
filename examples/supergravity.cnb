					"source": "\\begin{dmath*}{}\\text{Property Spinor attached to~}\\left[\\epsilon, \\discretionary{}{}{}\\psi_{\\mu}, \\discretionary{}{}{}\\psi_{\\mu \\nu}\\right].\\end{dmath*}"
