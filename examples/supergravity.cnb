							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\int{ -  1/2 R_{\\mu \\nu r s} \\delta^{m s} \\delta^{n r} e e_{m}^{\\mu} e_{n}^{\\nu} -  1/2 \\bar{\\psi_{\\mu}} \\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho}}{x}"
						}
					],
					"source": "\\begin{dmath*}{}\\int \\left( - \\frac{1}{2}\\,R_{\\mu \\nu r s} \\delta^{m s} \\delta^{n r} e e_{m}\\,^{\\mu} e_{n}\\,^{\\nu}\\discretionary{}{}{} - \\frac{1}{2}\\,\\bar{\\psi_{\\mu}} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\right)\\,\\,{\\rm d}x\\end{dmath*}"
				}
			],
			"source": "L:= \\int{-1/2 e e_{n}^{\\nu} e_{m}^{\\mu} R_{\\mu\\nu r s} \\delta^{n r} \\delta^{m s}\n                 - 1/2 e \\bar{\\psi_\\mu} \\Gamma^{\\mu\\nu\\rho} D_{\\nu}{\\psi_{\\rho}} }{x};\nrewrite_indices(_, $\\Gamma^{m n p}$, $e_{n}^{\\mu}$ );"
		},
		{
			"cell_id": 11338359634648115959,
