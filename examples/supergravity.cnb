					"cells": [
						{
							"cell_id": 9397142947859832208,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\int{ -  1/2 R_{\\mu \\nu r s} \\delta^{m s} \\delta^{n r} e e_{m}^{\\mu} e_{n}^{\\nu} -  1/2 \\bar{\\psi_{\\mu}} \\Gamma^{\\mu \\nu \\rho} D_{\\nu}(\\psi_{\\rho}) e}{x}"
						}
					],
					"source": "\\begin{dmath*}{}\\int \\left( - \\frac{1}{2}\\,R_{\\mu \\nu r s} \\delta^{m s} \\delta^{n r} e e_{m}\\,^{\\mu} e_{n}\\,^{\\nu}\\discretionary{}{}{} - \\frac{1}{2}\\,\\bar{\\psi_{\\mu}} \\Gamma^{\\mu \\nu \\rho} D_{\\nu}{\\psi_{\\rho}} e\\right)\\,\\,{\\rm d}x\\end{dmath*}"
				},
				{
					"cell_id": 3967185722192133079,
					"cell_origin": "server",
