					"cell_type": "latex_view",
					"source": "\\begin{dmath*}{}D_{\\mu}{D_{\\nu}{\\psi_{\\rho}}}-D_{\\nu}{D_{\\mu}{\\psi_{\\rho}}}\\end{dmath*}"
				}
			],
			"source": "riem:= D_{\\mu}{D_{\\nu}{\\psi_{\\rho}}} - D_{\\nu}{D_{\\mu}{\\psi_{\\rho}}};"
		},
		{
			"cell_id": 6576647461762016858,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 715606967776631592,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"source": "\\begin{dmath*}{}D_{\\mu}\\left(A??\\right) = \\partial_{\\mu}\\left(A??\\right)+\\frac{1}{4}\\omega_{\\mu m n} \\Gamma^{m n} A??\\end{dmath*}"
				}
			],
			"source": "covd:= D_{\\mu}{A??} = \\partial_{\\mu}{A??} + 1/4 \\omega_{\\mu m n} \\Gamma^{m n} A??;"
		},
		{
			"cell_id": 4742762019531249320,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 2694868041410450849,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"source": "\\begin{dmath*}{}\\partial_{\\mu}\\left(\\partial_{\\nu}{\\psi_{\\rho}}+\\frac{1}{4}\\Gamma^{m n} \\omega_{\\nu m n} \\psi_{\\rho}\\right)+\\frac{1}{4}\\Gamma^{p q} \\omega_{\\mu p q} \\left(\\partial_{\\nu}{\\psi_{\\rho}}+\\frac{1}{4}\\Gamma^{m n} \\omega_{\\nu m n} \\psi_{\\rho}\\right)-\\partial_{\\nu}\\left(\\partial_{\\mu}{\\psi_{\\rho}}+\\frac{1}{4}\\Gamma^{m n} \\omega_{\\mu m n} \\psi_{\\rho}\\right) - \\frac{1}{4}\\Gamma^{p q} \\omega_{\\nu p q} \\left(\\partial_{\\mu}{\\psi_{\\rho}}+\\frac{1}{4}\\Gamma^{m n} \\omega_{\\mu m n} \\psi_{\\rho}\\right)\\end{dmath*}"
				}
			],
			"source": "substitute(riem, covd);"
		},
		{
			"cell_id": 13319709224939475438,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 16772793258979490707,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"source": "\\begin{dmath*}{}\\frac{1}{4}\\Gamma^{m n} \\partial_{\\mu}{\\omega_{\\nu m n}} \\psi_{\\rho} - \\frac{1}{2}\\Gamma^{m n} \\delta^{p q} \\omega_{\\mu m p} \\omega_{\\nu n q} \\psi_{\\rho} - \\frac{1}{4}\\Gamma^{m n} \\partial_{\\nu}{\\omega_{\\mu m n}} \\psi_{\\rho}\\end{dmath*}"
				}
			],
			"source": "distribute(_)\nproduct_rule(_)\njoin_gamma(_)\ndistribute(_)\nunwrap(_)\ncanonicalise(_)\nrename_dummies(_);"
		},
		{
			"cell_id": 302148782213352626,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 7876579475656630163,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"source": "\\begin{dmath*}{}\\frac{1}{4}\\Gamma^{m n} \\left(\\partial_{\\mu}{\\omega_{\\nu m n}}-\\partial_{\\nu}{\\omega_{\\mu m n}}+\\delta^{p q} \\omega_{\\mu m p} \\omega_{\\nu q n}-\\delta^{p q} \\omega_{\\mu q n} \\omega_{\\nu m p}\\right)\\end{dmath*}"
				}
			],
			"source": "goal:= \\frac{1}{4} \\Gamma^{m n} ( \\partial_{\\mu}{\\omega_{\\nu m n}} - \\partial_{\\nu}{\\omega_{\\mu m n}} + \n                                 \\omega_{\\mu m p} \\omega_{\\nu q n} \\delta^{p q} - \\omega_{\\nu m p} \\omega_{\\mu q n} \\delta^{p q});"
		},
