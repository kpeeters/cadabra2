							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\int{ -  1/2 R_{\\mu \\nu r s} \\bar{\\epsilon} \\Gamma^{p} \\delta^{m s} \\delta^{n r} \\psi_{\\rho} e e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} +  1/2 R_{\\mu \\nu r s} \\bar{\\epsilon} \\Gamma^{p} \\delta^{m s} \\delta^{n r} \\psi_{\\rho} e e_{m}^{\\rho} e_{n}^{\\nu} e_{p}^{\\mu} +  1/2 R_{\\mu \\nu r s} \\bar{\\epsilon} \\Gamma^{p} \\delta^{m s} \\delta^{n r} \\psi_{\\rho} e e_{m}^{\\mu} e_{n}^{\\rho} e_{p}^{\\nu} -  1/2 \\bar{D_{\\mu}(\\epsilon)} \\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} -  1/8 R_{\\nu \\rho q r} \\bar{\\psi_{\\mu}} \\Gamma^{m n p} \\Gamma^{q r} \\epsilon e e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} +  1/2 \\bar{\\psi_{\\mu}} \\Gamma^{m n p} \\bar{\\epsilon} D_{\\nu}(\\psi_{\\rho}) \\Gamma^{q} \\psi_{\\sigma} e e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} e_{q}^{\\sigma} -  1/2 \\bar{\\psi_{\\mu}} \\Gamma^{m n p} \\bar{\\epsilon} D_{\\nu}(\\psi_{\\rho}) \\Gamma^{q} \\psi_{\\sigma} e e_{m}^{\\sigma} e_{n}^{\\nu} e_{p}^{\\rho} e_{q}^{\\mu} -  1/2 \\bar{\\psi_{\\mu}} \\Gamma^{m n p} \\bar{\\epsilon} D_{\\nu}(\\psi_{\\rho}) \\Gamma^{q} \\psi_{\\sigma} e e_{m}^{\\mu} e_{n}^{\\sigma} e_{p}^{\\rho} e_{q}^{\\nu} -  1/2 \\bar{\\psi_{\\mu}} \\Gamma^{m n p} \\bar{\\epsilon} D_{\\nu}(\\psi_{\\rho}) \\Gamma^{q} \\psi_{\\sigma} e e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\sigma} e_{q}^{\\rho}}{x}"
