					"cell_type": "latex_view",
					"source": "\\begin{dmath*}{}\\text{Property Indices(position=independent) attached to~}\\left[m, \\discretionary{}{}{}n, \\discretionary{}{}{}p, \\discretionary{}{}{}q, \\discretionary{}{}{}r, \\discretionary{}{}{}s, \\discretionary{}{}{}t, \\discretionary{}{}{}u\\right].\\end{dmath*}"
