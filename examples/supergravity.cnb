					"cell_origin": "server",
					"cell_type": "latex_view",
					"source": "\\begin{dmath*}{}\\frac{1}{4}\\Gamma^{m n} \\partial_{\\mu}{\\omega_{\\nu m n}} - \\frac{1}{4}\\Gamma^{m n} \\partial_{\\nu}{\\omega_{\\mu m n}}+\\frac{1}{4}\\Gamma^{m n} \\delta^{p q} \\omega_{\\mu m p} \\omega_{\\nu q n} - \\frac{1}{4}\\Gamma^{m n} \\delta^{p q} \\omega_{\\mu q n} \\omega_{\\nu m p}\\end{dmath*}"
				}
			],
			"source": "distribute(_);"
		},
