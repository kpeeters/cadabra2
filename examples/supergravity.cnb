					"cell_origin": "server",
					"cell_type": "latex_view",
					"source": "\\begin{dmath*}{}\\text{Property Depends attached to~}\\left[e_{m}\\,^{\\mu}, \\discretionary{}{}{}\\psi_{\\mu}, \\discretionary{}{}{}e, \\discretionary{}{}{}T^{\\mu}\\,_{\\nu \\rho}, \\discretionary{}{}{}\\omega_{\\mu m n}\\right].\\end{dmath*}"
				}
