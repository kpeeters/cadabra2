					"cells": [
						{
							"cell_id": 5213371486718264909,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "{e_{n}^{\\mu} -> -\\bar{\\epsilon} \\Gamma^{m} \\psi_{\\nu} e_{m}^{\\mu} e_{n}^{\\nu}, e -> \\bar{\\epsilon} \\Gamma^{n} \\psi_{\\mu} e e_{n}^{\\mu}, \\psi_{\\mu} -> D_{\\mu}(\\epsilon)}"
						}
					],
					"source": "\\begin{dmath*}{}\\left[e_{n}\\,^{\\mu} \\rightarrow -\\,\\bar{\\epsilon} \\Gamma^{m} \\psi_{\\nu} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu}, \\discretionary{}{}{}e \\rightarrow \\bar{\\epsilon} \\Gamma^{n} \\psi_{\\mu} e e_{n}\\,^{\\mu}, \\discretionary{}{}{}\\psi_{\\mu} \\rightarrow D_{\\mu}{\\epsilon}\\right]\\end{dmath*}"
				}
			],
			"source": "susy:= { e_{n}^{\\mu} -> -\\bar{\\epsilon} \\Gamma^m \\psi_\\nu e_{m}^{\\mu} e_{n}^{\\nu},\n         e           -> e \\bar{\\epsilon} \\Gamma^n \\psi_\\mu e_{n}^{\\mu},\n         \\psi_\\mu    -> D_{\\mu}{\\epsilon} };"
		},
		{
			"cell_id": 3577460045012385844,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 6342186789246323905,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 4770788999975028821,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\int{ -  1/2 R_{\\mu \\nu r s} \\bar{\\epsilon} \\Gamma^{p} \\delta^{m s} \\delta^{n r} \\psi_{\\rho} e e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} +  1/2 R_{\\mu \\nu r s} \\bar{\\epsilon} \\Gamma^{p} \\delta^{m s} \\delta^{n r} \\psi_{\\rho} e e_{m}^{\\rho} e_{n}^{\\nu} e_{p}^{\\mu} +  1/2 R_{\\mu \\nu r s} \\bar{\\epsilon} \\Gamma^{p} \\delta^{m s} \\delta^{n r} \\psi_{\\rho} e e_{m}^{\\mu} e_{n}^{\\rho} e_{p}^{\\nu} -  1/2 \\bar{D_{\\mu}(\\epsilon)} \\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} -  1/2 \\bar{\\psi_{\\mu}} \\Gamma^{m n p} D_{\\nu}(D_{\\rho}(\\epsilon)) e e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} +  1/2 \\bar{\\psi_{\\mu}} \\Gamma^{m n p} \\bar{\\epsilon} D_{\\nu}(\\psi_{\\rho}) \\Gamma^{q} \\psi_{\\sigma} e e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} e_{q}^{\\sigma} -  1/2 \\bar{\\psi_{\\mu}} \\Gamma^{m n p} \\bar{\\epsilon} D_{\\nu}(\\psi_{\\rho}) \\Gamma^{q} \\psi_{\\sigma} e e_{m}^{\\sigma} e_{n}^{\\nu} e_{p}^{\\rho} e_{q}^{\\mu} -  1/2 \\bar{\\psi_{\\mu}} \\Gamma^{m n p} \\bar{\\epsilon} D_{\\nu}(\\psi_{\\rho}) \\Gamma^{q} \\psi_{\\sigma} e e_{m}^{\\mu} e_{n}^{\\sigma} e_{p}^{\\rho} e_{q}^{\\nu} -  1/2 \\bar{\\psi_{\\mu}} \\Gamma^{m n p} \\bar{\\epsilon} D_{\\nu}(\\psi_{\\rho}) \\Gamma^{q} \\psi_{\\sigma} e e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\sigma} e_{q}^{\\rho}}{x}"
						}
					],
					"source": "\\begin{dmath*}{}\\int \\left( - \\frac{1}{2}\\,R_{\\mu \\nu r s} \\bar{\\epsilon} \\Gamma^{p} \\delta^{m s} \\delta^{n r} \\psi_{\\rho} e e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{}+\\frac{1}{2}\\,R_{\\mu \\nu r s} \\bar{\\epsilon} \\Gamma^{p} \\delta^{m s} \\delta^{n r} \\psi_{\\rho} e e_{m}\\,^{\\rho} e_{n}\\,^{\\nu} e_{p}\\,^{\\mu}\\discretionary{}{}{}+\\frac{1}{2}\\,R_{\\mu \\nu r s} \\bar{\\epsilon} \\Gamma^{p} \\delta^{m s} \\delta^{n r} \\psi_{\\rho} e e_{m}\\,^{\\mu} e_{n}\\,^{\\rho} e_{p}\\,^{\\nu}\\discretionary{}{}{} - \\frac{1}{2}\\,\\bar{D_{\\mu}{\\epsilon}} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{} - \\frac{1}{2}\\,\\bar{\\psi_{\\mu}} \\Gamma^{m n p} D_{\\nu}{D_{\\rho}{\\epsilon}} e e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{}+\\frac{1}{2}\\,\\bar{\\psi_{\\mu}} \\Gamma^{m n p} \\bar{\\epsilon} D_{\\nu}{\\psi_{\\rho}} \\Gamma^{q} \\psi_{\\sigma} e e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho} e_{q}\\,^{\\sigma}\\discretionary{}{}{} - \\frac{1}{2}\\,\\bar{\\psi_{\\mu}} \\Gamma^{m n p} \\bar{\\epsilon} D_{\\nu}{\\psi_{\\rho}} \\Gamma^{q} \\psi_{\\sigma} e e_{m}\\,^{\\sigma} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho} e_{q}\\,^{\\mu}\\discretionary{}{}{} - \\frac{1}{2}\\,\\bar{\\psi_{\\mu}} \\Gamma^{m n p} \\bar{\\epsilon} D_{\\nu}{\\psi_{\\rho}} \\Gamma^{q} \\psi_{\\sigma} e e_{m}\\,^{\\mu} e_{n}\\,^{\\sigma} e_{p}\\,^{\\rho} e_{q}\\,^{\\nu}\\discretionary{}{}{} - \\frac{1}{2}\\,\\bar{\\psi_{\\mu}} \\Gamma^{m n p} \\bar{\\epsilon} D_{\\nu}{\\psi_{\\rho}} \\Gamma^{q} \\psi_{\\sigma} e e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\sigma} e_{q}\\,^{\\rho}\\right)\\,\\,{\\rm d}x\\end{dmath*}"
				}
			],
			"source": "vary(L, susy);"
		},
