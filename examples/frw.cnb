							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\components_{\\mu \\nu}({{t, t} =  1/2  + 3\\partial_{t t}(a) (a)**(-1), {r, r} = (2k +  1/2 (a)**2 + a \\partial_{t t}(a) + 2(\\partial_{t}(a))**2) (k (r)**2-1)**(-1), {\\theta, \\theta} = (r)**2 (-2k -  1/2 (a)**2-a \\partial_{t t}(a)-2(\\partial_{t}(a))**2), {\\phi, \\phi} = (r)**2 (-2k -  1/2 (a)**2-a \\partial_{t t}(a)-2(\\partial_{t}(a))**2) (\\sin(\\theta))**2}) = \\components_{\\mu \\nu}({{t, t} = \\rho, {r, r} = p g_{r r}, {\\phi, \\phi} = p g_{\\phi \\phi}, {\\theta, \\theta} = p g_{\\theta \\theta}})"
						}
					],
					"source": "\\begin{dmath*}{}\\square{}_{\\mu}{}_{\\nu}\\left\\{\\begin{aligned}\\square{}_{t}{}_{t}& = \\frac{1}{2}\\,\\discretionary{}{}{}+\\frac{3\\,\\ddot{a}}{a}\\\\[-.5ex]\n\\square{}_{r}{}_{r}& = \\frac{\\left(2\\,k\\discretionary{}{}{}+\\frac{1}{2}\\,{a}^{2\\,}\\discretionary{}{}{}+a \\ddot{a}\\discretionary{}{}{}+2\\,{\\left(\\dot{a}\\right)}^{2\\,}\\right)}{\\left(k {r}^{2\\,}\\discretionary{}{}{}-\\,1\\right)}\\\\[-.5ex]\n\\square{}_{\\theta}{}_{\\theta}& = {r}^{2\\,} \\left(-2\\,k\\discretionary{}{}{} - \\frac{1}{2}\\,{a}^{2\\,}\\discretionary{}{}{}-\\,a \\ddot{a}\\discretionary{}{}{}-2\\,{\\left(\\dot{a}\\right)}^{2\\,}\\right)\\\\[-.5ex]\n\\square{}_{\\phi}{}_{\\phi}& = {r}^{2\\,} \\left(-2\\,k\\discretionary{}{}{} - \\frac{1}{2}\\,{a}^{2\\,}\\discretionary{}{}{}-\\,a \\ddot{a}\\discretionary{}{}{}-2\\,{\\left(\\dot{a}\\right)}^{2\\,}\\right) {\\left(\\sin{\\theta}\\right)}^{2\\,}\\\\[-.5ex]\n\\end{aligned}\\right\\}\n = \\square{}_{\\mu}{}_{\\nu}\\left\\{\\begin{aligned}\\square{}_{t}{}_{t}& = \\rho\\\\[-.5ex]\n\\square{}_{r}{}_{r}& = p g_{r r}\\\\[-.5ex]\n\\square{}_{\\phi}{}_{\\phi}& = p g_{\\phi \\phi}\\\\[-.5ex]\n\\square{}_{\\theta}{}_{\\theta}& = p g_{\\theta \\theta}\\\\[-.5ex]\n\\end{aligned}\\right\\}\n\\end{dmath*}"
