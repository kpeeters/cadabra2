					"cells": [
						{
							"cell_id": 14283761756052485368,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "{g_{t t} = -1, g_{r r} = (a)**2 (1-k (r)**2)**(-1), g_{\\theta \\theta} = (a)**2 (r)**2, g_{\\phi \\phi} = (a)**2 (r)**2 (\\sin(\\theta))**2, g^{t t} = -1, g^{r r} = (-k (r)**2 + 1) (a)**(-2), g^{\\theta \\theta} = ((r)**2 (a)**2)**(-1), g^{\\phi \\phi} = ((r)**2 (a)**2 (\\sin(\\theta))**2)**(-1)}"
						}
					],
					"source": "\\begin{dmath*}{}\\left[g_{t t} = -\\,1, \\discretionary{}{}{}g_{r r} = \\frac{{a}^{2\\,}}{\\left(1\\discretionary{}{}{}-\\,k {r}^{2\\,}\\right)}, \\discretionary{}{}{}g_{\\theta \\theta} = {a}^{2\\,} {r}^{2\\,}, \\discretionary{}{}{}g_{\\phi \\phi} = {a}^{2\\,} {r}^{2\\,} {\\left(\\sin{\\theta}\\right)}^{2\\,}, \\discretionary{}{}{}g^{t t} = -\\,1, \\discretionary{}{}{}g^{r r} = \\frac{\\left(-\\,k {r}^{2\\,}\\discretionary{}{}{}+1\\right)}{{a}^{2\\,}}, \\discretionary{}{}{}g^{\\theta \\theta} = \\frac{1}{{r}^{2\\,} {a}^{2\\,}}, \\discretionary{}{}{}g^{\\phi \\phi} = \\frac{1}{{r}^{2\\,} {a}^{2\\,} {\\left(\\sin{\\theta}\\right)}^{2\\,}}\\right]\\end{dmath*}"
