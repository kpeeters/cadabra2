			"hidden": true,
			"source": "The inverse metric is computed by using \\verb|complete|,"
		},
		{
			"cell_id": 15020289295702173224,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 12091803111021337195,
					"cell_origin": "server",
