					"source": "\\begin{dmath*}{}\\left[T_{t t} = \\rho, \\discretionary{}{}{}T_{r r} = p g_{r r}, \\discretionary{}{}{}T_{\\phi \\phi} = p g_{\\phi \\phi}, \\discretionary{}{}{}T_{\\theta \\theta} = p g_{\\theta \\theta}\\right]\\end{dmath*}"
