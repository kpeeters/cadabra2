					"source": "\\begin{dmath*}{}R = \\frac{6\\,\\left(-\\,k\\discretionary{}{}{}-\\,a \\ddot{a}\\discretionary{}{}{}-\\,{\\left(\\dot{a}\\right)}^{2\\,}\\right)}{{a}^{2\\,}}\\end{dmath*}"
				}
