							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\components_{\\mu \\nu}({{t, t} = 3\\partial_{t t}(a) (a)**(-1), {r, r} = (2k + a \\partial_{t t}(a) + 2(\\partial_{t}(a))**2) (k (r)**2-1)**(-1), {\\theta, \\theta} = (r)**2 (-2k-a \\partial_{t t}(a)-2(\\partial_{t}(a))**2), {\\phi, \\phi} = (r)**2 (-2k-a \\partial_{t t}(a)-2(\\partial_{t}(a))**2) (\\sin(\\theta))**2}) -  1/2 g_{\\mu \\nu} = T_{\\mu \\nu}"
