					"cells": [
						{
							"cell_id": 12959117945164229946,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "K = R^{\\mu}_{\\nu \\rho \\sigma} R^{\\lambda}_{\\kappa \\gamma \\chi} g_{\\mu \\lambda} g^{\\nu \\kappa} g^{\\rho \\gamma} g^{\\sigma \\chi}"
						}
					],
					"source": "\\begin{dmath*}{}K = R^{\\mu}\\,_{\\nu \\rho \\sigma} R^{\\lambda}\\,_{\\kappa \\gamma \\chi} g_{\\mu \\lambda} g^{\\nu \\kappa} g^{\\rho \\gamma} g^{\\sigma \\chi}\\end{dmath*}"
				},
				{
					"cell_id": 3183155361182888076,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 12369220465416092365,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "K = 48(M)**2 (-a \\cos(\\theta) + r) (a \\cos(\\theta) + r) ((a)**2 (\\cos(\\theta))**2-4a r \\cos(\\theta) + (r)**2) ((a)**2 (\\cos(\\theta))**2 + 4a r \\cos(\\theta) + (r)**2) ((a)**2 (\\cos(\\theta))**2 + (r)**2)**(-6)"
						}
					],
					"source": "\\begin{dmath*}{}K = \\frac{48\\,{M}^{2\\,} \\left(-\\,a \\cos{\\theta}\\discretionary{}{}{}+r\\right) \\left(a \\cos{\\theta}\\discretionary{}{}{}+r\\right) \\left({a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}-4\\,a r \\cos{\\theta}\\discretionary{}{}{}+{r}^{2\\,}\\right) \\left({a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+4\\,a r \\cos{\\theta}\\discretionary{}{}{}+{r}^{2\\,}\\right)}{{\\left({a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{6\\,}}\\end{dmath*}"
				}
			],
			"source": "K:= K = R^{\\mu}_{\\nu\\rho\\sigma} R^{\\lambda}_{\\kappa\\gamma\\chi}\n           g_{\\mu\\lambda} g^{\\nu\\kappa} g^{\\rho\\gamma} g^{\\sigma\\chi}:\nsubstitute(K, rm)\nevaluate(K, ss, rhsonly=True, simplify=False)\ntrigrat(K);"
		},
		{
			"cell_id": 2165450762312916185,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 6129300068792447499,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "This is the known result\n\\begin{equation*}\nK = \\frac{48 M^2 \\left(r^2 - a^2\\cos^2\\theta\\right)\n          \\left(r^4 - 14 a^2 r^2\\cos^2\\theta + a^4\\cos^4\\theta\\right)}\n         {\\left(r^2 + a^2\\cos^2\\theta\\right)^6}\\,,\n\\end{equation*}\nin factorised form. It is finite at the horizons, and diverges only where\n$r^2 + a^2\\cos^2\\theta = 0$, that is at $r=0$, $\\theta=\\pi/2$: the ring\nsingularity. For $a=0$ it reduces to the Schwarzschild value:"
				}
			],
			"hidden": true,
			"source": "This is the known result\n\\begin{equation*}\nK = \\frac{48 M^2 \\left(r^2 - a^2\\cos^2\\theta\\right)\n          \\left(r^4 - 14 a^2 r^2\\cos^2\\theta + a^4\\cos^4\\theta\\right)}\n         {\\left(r^2 + a^2\\cos^2\\theta\\right)^6}\\,,\n\\end{equation*}\nin factorised form. It is finite at the horizons, and diverges only where\n$r^2 + a^2\\cos^2\\theta = 0$, that is at $r=0$, $\\theta=\\pi/2$: the ring\nsingularity. For $a=0$ it reduces to the Schwarzschild value:"
		},
		{
			"cell_id": 3262104324841490129,
