							"cell_type": "input_form",
							"source": "K = 48(M)**2 (r)**(-6)"
						}
					],
					"source": "\\begin{dmath*}{}K = \\frac{48\\,{M}^{2\\,}}{{r}^{6\\,}}\\end{dmath*}"
				}
			],
			"source": "K0:= @(K):\nsubstitute(K0, $a=0$)\ntrigrat(K0);"
