					"cell_id": 6262139408581249848,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "We can now compute the inverse metric with \\algo{complete}, and bring it into\ncanonical form."
				}
			],
			"hidden": true,
			"source": "We can now compute the inverse metric with \\algo{complete}, and bring it into\ncanonical form."
		},
		{
