right)}^{2\\,}}{{\\left({a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{3\\,} \\left(-2\\,M r\\discretionary{}{}{}+{a}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}\\\\[-.5ex]\n\\square{}_{\\theta}{}_{r}{}^{t}{}_{\\phi}& = \\frac{M a \\left(-\\,{a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+3\\,{r}^{2\\,}\\right) \\left(2\\,M {a}^{2\\,} r {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}-2\\,M {a}^{2\\,} r\\discretionary{}{}{}-\\,{a}^{4\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+3\\,{a}^{4\\,}\\discretionary{}{}{}-\\,{a}^{2\\,} {r}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+5\\,{a}^{2\\,} {r}^{2\\,}\\discretionary{}{}{}+2\\,{r}^{4\\,}\\right) \\sin{\\theta} \\cos{\\theta}}{{\\left({a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{3\\,} \\left(-2\\,M r\\discretionary{}{}{}+{a}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}\\\\[-.5ex]\n\\square{}_{t}{}_{\\phi}{}^{t}{}_{\\phi}& = \\frac{M r \\left(-3\\,{a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right) \\left(-2\\,M {a}^{2\\,} r {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+2\\,M {a}^{2\\,} r\\discretionary{}{}{}+{a}^{4\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{a}^{2\\,} {r}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{a}^{2\\,} {r}^{2\\,}\\discretionary{}{}{}+{r}^{4\\,}\\right) {\\left(\\sin{\\theta}\\right)}^{2\\,}}{{\\left({a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{4\\,}}\\\\[-.5ex]\n\\square{}_{t}{}_{t}{}^{t}{}_{\\phi}& = \\square{}_{\\phi}{}_{\\phi}{}^{\\phi}{}_{t} = -\\frac{2\\,{M}^{2\\,} a {r}^{2\\,} \\left(-3\\,{a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right) {\\left(\\sin{\\theta}\\right)}^{2\\,}}{{\\left({a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{4\\,}}\\\\[-.5ex]\n\\square{}_{t}{}_{\\phi}{}^{\\phi}{}_{\\phi}& = \\square{}_{\\phi}{}_{t}{}^{t}{}_{t} = \\frac{2\\,{M}^{2\\,} a {r}^{2\\,} \\left(-3\\,{a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right) {\\left(\\sin{\\theta}\\right)}^{2\\,}}{{\\left({a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{4\\,}}\\\\[-.5ex]\n\\square{}_{t}{}_{t}{}^{\\phi}{}_{\\phi}& = \\frac{M r \\left(-3\\,{a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right) \\left(-2\\,M r\\discretionary{}{}{}+{a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}{{\\left({a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{4\\,}}\\\\[-.5ex]\n\\square{}_{\\phi}{}_{\\phi}{}^{t}{}_{t}& = -\\frac{M r \\left(-3\\,{a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right) \\left(-2\\,M {a}^{2\\,} r {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+2\\,M {a}^{2\\,} r\\discretionary{}{}{}+{a}^{4\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{a}^{2\\,} {r}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{a}^{2\\,} {r}^{2\\,}\\discretionary{}{}{}+{r}^{4\\,}\\right) {\\left(\\sin{\\theta}\\right)}^{2\\,}}{{\\left({a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{4\\,}}\\\\[-.5ex]\n\\square{}_{\\phi}{}_{t}{}^{\\phi}{}_{t}& = -\\frac{M r \\left(-3\\,{a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right) \\left(-2\\,M r\\discretionary{}{}{}+{a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}{{\\left({a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{4\\,}}\\\\[-.5ex]\n\\square{}_{t}{}_{\\theta}{}^{r}{}_{\\phi}& = \\frac{M a \\left(-\\,{a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+3\\,{r}^{2\\,}\\right) \\left(-2\\,M r\\discretionary{}{}{}+{a}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right) \\sin{\\theta} \\cos{\\theta}}{{\\left({a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{3\\,}}\\\\[-.5ex]\n\\square{}_{t}{}_{r}{}^{\\theta}{}_{\\phi}& = -\\frac{M a \\left(-\\,{a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+3\\,{r}^{2\\,}\\right) \\sin{\\theta} \\cos{\\theta}}{{\\left({a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{3\\,}}\\\\[-.5ex]\n\\square{}_{\\phi}{}_{\\theta}{}^{r}{}_{t}& = -\\frac{M a \\left(-\\,{a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+3\\,{r}^{2\\,}\\right) \\left(-2\\,M r\\discretionary{}{}{}+{a}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right) \\sin{\\theta} \\cos{\\theta}}{{\\left({a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{3\\,}}\\\\[-.5ex]\n\\square{}_{\\phi}{}_{r}{}^{\\theta}{}_{t}& = \\frac{M a \\left(-\\,{a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+3\\,{r}^{2\\,}\\right) \\sin{\\theta} \\cos{\\theta}}{{\\left({a}^{2\\,} {\\left(\\cos{\\theta}\\right)}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{3\\,}}\\\\[-.5ex]\n\\end{aligned}\\right\\}\n\\end{dmath*}"
				}
			],
			"source": "rm:= R^{\\rho}_{\\sigma\\mu\\nu} = \\partial_{\\mu}{\\Gamma^{\\rho}_{\\nu\\sigma}}\n                                  -\\partial_{\\nu}{\\Gamma^{\\rho}_{\\mu\\sigma}}\n                                  +\\Gamma^{\\rho}_{\\mu\\lambda} \\Gamma^{\\lambda}_{\\nu\\sigma}\n                                  -\\Gamma^{\\rho}_{\\nu\\lambda} \\Gamma^{\\lambda}_{\\mu\\sigma}:\nsubstitute(rm, ch)\nevaluate(rm, ss, rhsonly=True, simplify=False)\ntrigrat(rm);"
		},
