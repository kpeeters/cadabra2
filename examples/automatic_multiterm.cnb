			"cell_origin": "client",
			"cell_type": "input",
			"source": "W_{m n p q}::WeylTensor."
		},
		{
			"cell_id": 11431165958746591053,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 7157178214904563227,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 6465587795030309523,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "0"
						}
					],
					"source": "\\begin{dmath*}{}0\\,\\end{dmath*}"
				}
			],
			"source": "ex:= W_{p q r s} W_{p t r u} W_{t v q w} W_{u v s w} \n  - W_{p q r s} W_{p q t u} W_{r v t w} W_{s v u w}\n  - W_{m n a b} W_{n p b c} W_{m s c d} W_{s p d a}\n  + (1/4) W_{m n a b} W_{p s b a} W_{m p c d} W_{n s d c};"
		},
