							"source": " -  1/8 \\bar{\\epsilon} \\varepsilon^{m n p q} \\gamma_{5} \\chi_{m n} \\bar{\\psi_{p}} \\varepsilon_{q s u t} \\Gamma^{u t} \\gamma_{5} \\delta^{s r} \\psi_{r} e +  1/16 \\bar{\\epsilon} \\varepsilon^{m n p q} \\gamma_{5} \\chi_{m}^{r} \\bar{\\psi_{n}} \\varepsilon_{p r s t} \\Gamma^{s t} \\gamma_{5} \\psi_{q} e -  1/16 \\bar{\\epsilon} \\varepsilon^{m n p q} \\gamma_{5} \\chi^{r}_{m} \\bar{\\psi_{n}} \\varepsilon_{p r s t} \\Gamma^{s t} \\gamma_{5} \\psi_{q} e"
						}
					],
					"source": "\\begin{dmath*}{} - \\frac{1}{8}\\,\\bar{\\epsilon} \\varepsilon^{m n p q} \\gamma_{5\\,} \\chi_{m n} \\bar{\\psi_{p}} \\varepsilon_{q s u t} \\Gamma^{u t} \\gamma_{5\\,} \\delta^{s r} \\psi_{r} e\\discretionary{}{}{}+\\frac{1}{16}\\,\\bar{\\epsilon} \\varepsilon^{m n p q} \\gamma_{5\\,} \\chi_{m}\\,^{r} \\bar{\\psi_{n}} \\varepsilon_{p r s t} \\Gamma^{s t} \\gamma_{5\\,} \\psi_{q} e\\discretionary{}{}{} - \\frac{1}{16}\\,\\bar{\\epsilon} \\varepsilon^{m n p q} \\gamma_{5\\,} \\chi^{r}\\,_{m} \\bar{\\psi_{n}} \\varepsilon_{p r s t} \\Gamma^{s t} \\gamma_{5\\,} \\psi_{q} e\\end{dmath*}"
				}
			],
			"source": "\\varepsilon{#}::EpsilonTensor(delta=\\delta).\n\\gamma_{5}::ImplicitIndex.\nsubstitute(tot, $\\Gamma_{m}^{n} -> \\Gamma_{m p} \\delta^{p n}$)\nsubstitute(tot, $\\Gamma^{m n p q} -> \\varepsilon^{m n p q} \\gamma_{5}$)\nsubstitute(tot, $\\Gamma_{m n} -> -1/2 \\varepsilon_{m n p q} \\Gamma^{p q} \\gamma_{5}$);"
		},
