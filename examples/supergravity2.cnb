					"source": "This should equal $\\tfrac14 R_{\\mu\\nu}{}^{mn}\\Gamma_{mn}\\psi_\\rho$, with the curvature of the spin connection given by"
				}
			],
			"hidden": true,
			"source": "This should equal $\\tfrac14 R_{\\mu\\nu}{}^{mn}\\Gamma_{mn}\\psi_\\rho$, with the curvature of the spin connection given by"
		},
		{
			"cell_id": 8053229271077692838,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 1793823139145014920,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 720311809234254231,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "R_{\\mu \\nu}^{m n} -> \\partial_{\\mu}(\\omega_{\\nu}^{m n})-\\partial_{\\nu}(\\omega_{\\mu}^{m n}) + \\omega_{\\mu}^{m q} \\delta_{q p} \\omega_{\\nu}^{p n}-\\omega_{\\nu}^{m q} \\delta_{q p} \\omega_{\\mu}^{p n}"
						}
					],
					"source": "\\begin{dmath*}{}R_{\\mu \\nu}\\,^{m n} \\rightarrow \\partial_{\\mu}{\\omega_{\\nu}\\,^{m n}}\\discretionary{}{}{}-\\,\\partial_{\\nu}{\\omega_{\\mu}\\,^{m n}}\\discretionary{}{}{}+\\omega_{\\mu}\\,^{m q} \\delta_{q p} \\omega_{\\nu}\\,^{p n}\\discretionary{}{}{}-\\,\\omega_{\\nu}\\,^{m q} \\delta_{q p} \\omega_{\\mu}\\,^{p n}\\end{dmath*}"
				}
			],
			"source": "Rdef:= R_{\\mu\\nu}^{m n} -> \\partial_{\\mu}{\\omega_{\\nu}^{m n}} - \\partial_{\\nu}{\\omega_{\\mu}^{m n}}\n         + \\omega_{\\mu}^{m q} \\delta_{q p} \\omega_{\\nu}^{p n} - \\omega_{\\nu}^{m q} \\delta_{q p} \\omega_{\\mu}^{p n};"
		},
		{
			"cell_id": 2114172826559709258,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 9736607724157119446,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 17479388983279116961,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": " 1/4 \\Gamma_{m n} \\partial_{\\mu}(\\omega_{\\nu}^{m n}) \\psi_{\\rho} -  1/2 \\Gamma^{m n} \\delta^{p q} \\omega_{\\mu m p} \\omega_{\\nu n q} \\psi_{\\rho} -  1/4 \\Gamma_{m n} \\partial_{\\nu}(\\omega_{\\mu}^{m n}) \\psi_{\\rho} -  1/4 R_{\\mu \\nu}^{m n} \\Gamma_{m n} \\psi_{\\rho}"
						}
					],
					"source": "\\begin{dmath*}{}\\frac{1}{4}\\,\\Gamma_{m n} \\partial_{\\mu}{\\omega_{\\nu}\\,^{m n}} \\psi_{\\rho}\\discretionary{}{}{} - \\frac{1}{2}\\,\\Gamma^{m n} \\delta^{p q} \\omega_{\\mu m p} \\omega_{\\nu n q} \\psi_{\\rho}\\discretionary{}{}{} - \\frac{1}{4}\\,\\Gamma_{m n} \\partial_{\\nu}{\\omega_{\\mu}\\,^{m n}} \\psi_{\\rho}\\discretionary{}{}{} - \\frac{1}{4}\\,R_{\\mu \\nu}\\,^{m n} \\Gamma_{m n} \\psi_{\\rho}\\end{dmath*}"
				},
