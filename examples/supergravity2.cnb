							"cell_origin": "server",
							"cell_type": "input_form",
							"source": " 1/2 e e_{q}^{\\lambda} D_{\\mu}(e^{q}_{\\lambda}) \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} +  1/2 e \\bar{\\epsilon} \\Gamma^{m n p} D_{\\mu}(D_{\\nu}(\\psi_{\\rho})) e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} -  1/2 e \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e_{m}^{\\lambda} D_{\\mu}(e^{q}_{\\lambda}) e_{q}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} -  1/2 e \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e_{m}^{\\mu} e_{n}^{\\lambda} D_{\\mu}(e^{q}_{\\lambda}) e_{q}^{\\nu} e_{p}^{\\rho} -  1/2 e \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\lambda} D_{\\mu}(e^{q}_{\\lambda}) e_{q}^{\\rho}"
						}
					],
					"source": "\\begin{dmath*}{}\\frac{1}{2}\\,e e_{q}\\,^{\\lambda} D_{\\mu}{e^{q}\\,_{\\lambda}} \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{}+\\frac{1}{2}\\,e \\bar{\\epsilon} \\Gamma^{m n p} D_{\\mu}{D_{\\nu}{\\psi_{\\rho}}} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{} - \\frac{1}{2}\\,e \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\lambda} D_{\\mu}{e^{q}\\,_{\\lambda}} e_{q}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{} - \\frac{1}{2}\\,e \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\mu} e_{n}\\,^{\\lambda} D_{\\mu}{e^{q}\\,_{\\lambda}} e_{q}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{} - \\frac{1}{2}\\,e \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\lambda} D_{\\mu}{e^{q}\\,_{\\lambda}} e_{q}\\,^{\\rho}\\end{dmath*}"
				}
