							"source": " 1/2 D_{\\mu}(e^{q}_{\\sigma}) \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} e_{q}^{\\sigma} -  1/2 \\bar{\\epsilon} \\Gamma^{m n p} D_{\\mu}(\\psi_{\\rho}) D_{\\nu}(e^{q}_{\\sigma}) e e_{m}^{\\mu} e_{n}^{\\rho} e_{p}^{\\sigma} e_{q}^{\\nu} -  1/2 \\bar{\\epsilon} \\Gamma^{m n p} D_{\\mu}(\\psi_{\\rho}) D_{\\nu}(e^{q}_{\\sigma}) e e_{m}^{\\rho} e_{n}^{\\nu} e_{p}^{\\sigma} e_{q}^{\\mu} +  1/2 \\bar{\\epsilon} \\Gamma^{m n p} D_{\\mu}(\\psi_{\\rho}) D_{\\nu}(e^{q}_{\\sigma}) e e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\sigma} e_{q}^{\\rho}"
						}
					],
					"source": "\\begin{dmath*}{}\\frac{1}{2}\\,D_{\\mu}{e^{q}\\,_{\\sigma}} \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho} e_{q}\\,^{\\sigma}\\discretionary{}{}{} - \\frac{1}{2}\\,\\bar{\\epsilon} \\Gamma^{m n p} D_{\\mu}{\\psi_{\\rho}} D_{\\nu}{e^{q}\\,_{\\sigma}} e e_{m}\\,^{\\mu} e_{n}\\,^{\\rho} e_{p}\\,^{\\sigma} e_{q}\\,^{\\nu}\\discretionary{}{}{} - \\frac{1}{2}\\,\\bar{\\epsilon} \\Gamma^{m n p} D_{\\mu}{\\psi_{\\rho}} D_{\\nu}{e^{q}\\,_{\\sigma}} e e_{m}\\,^{\\rho} e_{n}\\,^{\\nu} e_{p}\\,^{\\sigma} e_{q}\\,^{\\mu}\\discretionary{}{}{}+\\frac{1}{2}\\,\\bar{\\epsilon} \\Gamma^{m n p} D_{\\mu}{\\psi_{\\rho}} D_{\\nu}{e^{q}\\,_{\\sigma}} e e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\sigma} e_{q}\\,^{\\rho}\\end{dmath*}"
