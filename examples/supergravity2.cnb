					"source": "\\begin{dmath*}{}\\frac{1}{2}\\,e e_{q}\\,^{\\sigma} D_{\\mu}{e^{q}\\,_{\\sigma}} \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{} - \\frac{1}{2}\\,e \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\sigma} D_{\\mu}{e^{q}\\,_{\\sigma}} e_{q}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{} - \\frac{1}{2}\\,e \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\mu} e_{n}\\,^{\\sigma} D_{\\mu}{e^{q}\\,_{\\sigma}} e_{q}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{} - \\frac{1}{2}\\,e \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\sigma} D_{\\mu}{e^{q}\\,_{\\sigma}} e_{q}\\,^{\\rho}\\end{dmath*}"
