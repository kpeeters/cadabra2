					"source": "\\begin{dmath*}{} - \\frac{1}{2}\\,\\int \\left(-\\,e e_{q}\\,^{\\lambda} D_{\\mu}{e^{q}\\,_{\\lambda}} \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{} - \\frac{1}{8}\\,e \\bar{\\epsilon} \\Gamma^{m n p} R_{\\mu \\nu}\\,^{q r} \\Gamma_{q r} \\psi_{\\rho} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{}+e \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\lambda} D_{\\mu}{e^{q}\\,_{\\lambda}} e_{q}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{}+e \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\mu} e_{n}\\,^{\\lambda} D_{\\mu}{e^{q}\\,_{\\lambda}} e_{q}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{}+e \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\lambda} D_{\\mu}{e^{q}\\,_{\\lambda}} e_{q}\\,^{\\rho}\\discretionary{}{}{}+\\frac{1}{8}\\,e \\bar{\\psi_{\\mu}} \\Gamma^{m n p} R_{\\nu \\rho}\\,^{q r} \\Gamma_{q r} \\epsilon e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\right)\\,\\,{\\rm d}x\\end{dmath*}"
