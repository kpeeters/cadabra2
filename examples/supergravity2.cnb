							"cell_type": "input_form",
							"source": " -  1/2 e \\bar{\\psi_{\\mu}} \\Gamma^{m n p} D_{\\nu}(D_{\\rho}(\\epsilon)) e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho}"
						}
					],
					"source": "\\begin{dmath*}{} - \\frac{1}{2}\\,e \\bar{\\psi_{\\mu}} \\Gamma^{m n p} D_{\\nu}{D_{\\rho}{\\epsilon}} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\end{dmath*}"
				},
				{
					"cell_id": 10753403620558273221,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 8767699507930213786,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": " -  1/16 e \\bar{\\psi_{\\mu}} \\Gamma^{m n p} R_{\\nu \\rho}^{q r} \\Gamma_{q r} \\epsilon e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho}"
						}
					],
					"source": "\\begin{dmath*}{} - \\frac{1}{16}\\,e \\bar{\\psi_{\\mu}} \\Gamma^{m n p} R_{\\nu \\rho}\\,^{q r} \\Gamma_{q r} \\epsilon e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\end{dmath*}"
				}
			],
			"source": "dpsiu:= @(dL32);\ntake_match(dpsiu, $D_{\\nu}{D_{\\rho}{\\epsilon}} A??$);\nsubstitute(dpsiu, $D_{\\nu}{D_{\\rho}{\\epsilon}} -> 1/8 R_{\\nu\\rho}^{m n} \\Gamma_{m n} \\epsilon$);"
		},
		{
			"cell_id": 190780982038380153,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 190780982038380153,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "In the second term we use $\\overline{D_\\mu\\epsilon} = D_\\mu\\bar\\epsilon\n= \\partial_\\mu\\bar\\epsilon - \\tfrac14\\bar\\epsilon\\,\\omega_\\mu{}^{mn}\\Gamma_{mn}$ (vN~1.7 eq.~(8)),\nand integrate by parts to remove the derivative from $\\bar\\epsilon$. The total derivative is\nthe derivative of a Lorentz scalar, so $D_\\mu=\\partial_\\mu$ on it and we may drop it. Integrating\nby parts needs an integral, so we wrap the expression in one."
				}
			],
			"hidden": true,
			"source": "In the second term we use $\\overline{D_\\mu\\epsilon} = D_\\mu\\bar\\epsilon\n= \\partial_\\mu\\bar\\epsilon - \\tfrac14\\bar\\epsilon\\,\\omega_\\mu{}^{mn}\\Gamma_{mn}$ (vN~1.7 eq.~(8)),\nand integrate by parts to remove the derivative from $\\bar\\epsilon$. The total derivative is\nthe derivative of a Lorentz scalar, so $D_\\mu=\\partial_\\mu$ on it and we may drop it. Integrating\nby parts needs an integral, so we wrap the expression in one."
		},
