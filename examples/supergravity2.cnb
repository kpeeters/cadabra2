					"source": "\\begin{dmath*}{} - \\frac{1}{4}\\,\\bar{\\epsilon} \\Gamma^{m} \\psi_{\\nu} \\bar{\\psi_{\\rho}} \\Gamma^{n p q} D_{\\mu}{\\psi_{\\sigma}} e e_{m}\\,^{\\nu} e_{n}\\,^{\\rho} e_{p}\\,^{\\mu} e_{q}\\,^{\\sigma}\\discretionary{}{}{}+\\frac{1}{4}\\,\\bar{\\psi_{\\nu}} \\Gamma^{m n p} D_{\\mu}{\\psi_{\\rho}} \\bar{\\epsilon} \\Gamma^{q} \\psi_{\\sigma} e e_{m}\\,^{\\mu} e_{n}\\,^{\\rho} e_{p}\\,^{\\sigma} e_{q}\\,^{\\nu}\\discretionary{}{}{} - \\frac{1}{4}\\,\\bar{\\psi_{\\nu}} \\Gamma^{m n p} D_{\\mu}{\\psi_{\\rho}} \\bar{\\epsilon} \\Gamma^{q} \\psi_{\\sigma} e e_{m}\\,^{\\nu} e_{n}\\,^{\\rho} e_{p}\\,^{\\sigma} e_{q}\\,^{\\mu}\\discretionary{}{}{}+\\frac{1}{4}\\,\\bar{\\psi_{\\nu}} \\Gamma^{m n p} D_{\\mu}{\\psi_{\\rho}} \\bar{\\epsilon} \\Gamma^{q} \\psi_{\\sigma} e e_{m}\\,^{\\nu} e_{n}\\,^{\\mu} e_{p}\\,^{\\sigma} e_{q}\\,^{\\rho}\\end{dmath*}"
