							"cell_origin": "server",
							"cell_type": "input_form",
							"source": " -  1/2 e \\bar{\\psi_{\\mu}} \\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho}"
						}
					],
					"source": "\\begin{dmath*}{} - \\frac{1}{2}\\,e \\bar{\\psi_{\\mu}} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\end{dmath*}"
				}
			],
			"source": "L32:= -1/2 e \\bar{\\psi_{\\mu}} \\Gamma^{\\mu\\nu\\rho} D_{\\nu}{\\psi_{\\rho}};\nrewrite_indices(_, $\\Gamma^{m n p}$, $e_{m}^{\\mu}$);"
		},
		{
			"cell_id": 889822531485330783,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 889822531485330783,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "\\subsection*{Transformation rules}\n\nFrom $\\delta e^m{}_\\mu = \\tfrac12\\bar\\epsilon\\Gamma^m\\psi_\\mu$ and $\\delta(e^m{}_\\mu e_n{}^\\mu)=0$\nit follows that the inverse vielbein transforms as\n$\\delta e_m{}^\\mu = -e_m{}^\\nu\\,(\\delta e^n{}_\\nu)\\, e_n{}^\\mu$. The variation of the\ndeterminant is $\\delta e = e\\, e_m{}^\\mu\\delta e^m{}_\\mu$. These are the explicit\nvielbeine of vN~1.7 eq.~(1). The gravitini are varied separately, later."
				}
			],
			"hidden": true,
			"source": "\\subsection*{Transformation rules}\n\nFrom $\\delta e^m{}_\\mu = \\tfrac12\\bar\\epsilon\\Gamma^m\\psi_\\mu$ and $\\delta(e^m{}_\\mu e_n{}^\\mu)=0$\nit follows that the inverse vielbein transforms as\n$\\delta e_m{}^\\mu = -e_m{}^\\nu\\,(\\delta e^n{}_\\nu)\\, e_n{}^\\mu$. The variation of the\ndeterminant is $\\delta e = e\\, e_m{}^\\mu\\delta e^m{}_\\mu$. These are the explicit\nvielbeine of vN~1.7 eq.~(1). The gravitini are varied separately, later."
		},
		{
			"cell_id": 8714237158517167456,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 10746175003545510989,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 185481394066628403,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "{e_{m}^{\\mu} ->  -  1/2 \\bar{\\epsilon} \\Gamma^{n} \\psi_{\\nu} e_{m}^{\\nu} e_{n}^{\\mu}, e ->  1/2 e \\bar{\\epsilon} \\Gamma^{m} \\psi_{\\mu} e_{m}^{\\mu}}"
						}
					],
					"source": "\\begin{dmath*}{}\\left[e_{m}\\,^{\\mu} \\rightarrow  - \\frac{1}{2}\\,\\bar{\\epsilon} \\Gamma^{n} \\psi_{\\nu} e_{m}\\,^{\\nu} e_{n}\\,^{\\mu}, \\discretionary{}{}{}e \\rightarrow \\frac{1}{2}\\,e \\bar{\\epsilon} \\Gamma^{m} \\psi_{\\mu} e_{m}\\,^{\\mu}\\right]\\end{dmath*}"
				}
			],
			"source": "dvb:= { e_{m}^{\\mu} -> -1/2 \\bar{\\epsilon}\\Gamma^{n}\\psi_{\\nu} e_{m}^{\\nu} e_{n}^{\\mu},\n        e -> 1/2 e \\bar{\\epsilon}\\Gamma^{m}\\psi_{\\mu} e_{m}^{\\mu} };"
		},
		{
			"cell_id": 4780283821124169040,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 4780283821124169040,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "\\subsection*{Variation of the vielbeine in the Hilbert action}\n\nWe start with the variation of the explicit vielbeine in $\\mathcal{L}^{(2)}$, vN~1.7 eq.~(2)."
				}
			],
			"hidden": true,
			"source": "\\subsection*{Variation of the vielbeine in the Hilbert action}\n\nWe start with the variation of the explicit vielbeine in $\\mathcal{L}^{(2)}$, vN~1.7 eq.~(2)."
		},
		{
			"cell_id": 3599411224642237442,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 2735476738129371198,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 6753776333026859032,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": " -  1/2 e e_{m}^{\\nu} e_{n}^{\\mu} R_{\\mu \\nu}^{m n}"
						}
					],
					"source": "\\begin{dmath*}{} - \\frac{1}{2}\\,e e_{m}\\,^{\\nu} e_{n}\\,^{\\mu} R_{\\mu \\nu}\\,^{m n}\\end{dmath*}"
				},
				{
					"cell_id": 12662714659360973567,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 6316429482434787370,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": " 1/4 R_{\\mu \\nu}^{m n} \\bar{\\epsilon} \\Gamma^{p} \\psi_{\\rho} e e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} -  1/2 R_{\\mu \\nu}^{m n} \\bar{\\epsilon} \\Gamma^{p} \\psi_{\\rho} e e_{m}^{\\mu} e_{n}^{\\rho} e_{p}^{\\nu}"
						}
					],
					"source": "\\begin{dmath*}{}\\frac{1}{4}\\,R_{\\mu \\nu}\\,^{m n} \\bar{\\epsilon} \\Gamma^{p} \\psi_{\\rho} e e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{} - \\frac{1}{2}\\,R_{\\mu \\nu}\\,^{m n} \\bar{\\epsilon} \\Gamma^{p} \\psi_{\\rho} e e_{m}\\,^{\\mu} e_{n}\\,^{\\rho} e_{p}\\,^{\\nu}\\end{dmath*}"
				}
			],
			"source": "dL2:= @(L2);\nvary(dL2, dvb)\ndistribute(dL2)\nsort_product(dL2)\ncanonicalise(dL2)\nrename_dummies(dL2)\ncollect_terms(dL2);"
		},
		{
			"cell_id": 1978409198700377821,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 1978409198700377821,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "This should be equal to\n\\begin{equation*}\n\\delta\\mathcal{L}^{(2)} = \\frac{e}{2}\\big(\\bar\\epsilon\\gamma^\\nu\\psi^a\\big)\\, G_{\\nu a}\\,,\\qquad\nG_{\\nu a} = R_{\\nu a} - \\tfrac12 e_{a\\nu} R\\,,\\qquad R_{\\nu a} = R_{\\mu\\nu ab}\\, e^{b\\mu}\\,.\n\\end{equation*}\nWritten out with all vielbeine explicit, this is"
				}
			],
			"hidden": true,
			"source": "This should be equal to\n\\begin{equation*}\n\\delta\\mathcal{L}^{(2)} = \\frac{e}{2}\\big(\\bar\\epsilon\\gamma^\\nu\\psi^a\\big)\\, G_{\\nu a}\\,,\\qquad\nG_{\\nu a} = R_{\\nu a} - \\tfrac12 e_{a\\nu} R\\,,\\qquad R_{\\nu a} = R_{\\mu\\nu ab}\\, e^{b\\mu}\\,.\n\\end{equation*}\nWritten out with all vielbeine explicit, this is"
		},
		{
			"cell_id": 2138589404594887461,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 12401495137477801656,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 11333776849748209291,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": " 1/2 e \\bar{\\epsilon} \\Gamma^{p} \\psi_{\\rho} e_{p}^{\\nu} e_{q}^{\\rho} (R_{\\mu \\nu}^{q r} e_{r}^{\\mu} -  1/2 e^{q}_{\\nu} R_{\\sigma \\lambda}^{s t} e_{s}^{\\lambda} e_{t}^{\\sigma})"
						}
					],
					"source": "\\begin{dmath*}{}\\frac{1}{2}\\,e \\bar{\\epsilon} \\Gamma^{p} \\psi_{\\rho} e_{p}\\,^{\\nu} e_{q}\\,^{\\rho} \\left(R_{\\mu \\nu}\\,^{q r} e_{r}\\,^{\\mu}\\discretionary{}{}{} - \\frac{1}{2}\\,e^{q}\\,_{\\nu} R_{\\sigma \\lambda}\\,^{s t} e_{s}\\,^{\\lambda} e_{t}\\,^{\\sigma}\\right)\\end{dmath*}"
				},
				{
					"cell_id": 4109463109963077965,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 6498721526794554271,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": " -  1/2 R_{\\mu \\nu}^{m n} \\bar{\\epsilon} \\Gamma^{p} \\psi_{\\rho} e e_{m}^{\\mu} e_{n}^{\\rho} e_{p}^{\\nu} +  1/4 R_{\\mu \\nu}^{m n} \\bar{\\epsilon} \\Gamma^{p} \\psi_{\\rho} e e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho}"
						}
					],
					"source": "\\begin{dmath*}{} - \\frac{1}{2}\\,R_{\\mu \\nu}\\,^{m n} \\bar{\\epsilon} \\Gamma^{p} \\psi_{\\rho} e e_{m}\\,^{\\mu} e_{n}\\,^{\\rho} e_{p}\\,^{\\nu}\\discretionary{}{}{}+\\frac{1}{4}\\,R_{\\mu \\nu}\\,^{m n} \\bar{\\epsilon} \\Gamma^{p} \\psi_{\\rho} e e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\end{dmath*}"
				}
			],
			"source": "eins:= 1/2 e \\bar{\\epsilon}\\Gamma^{p}\\psi_{\\rho} e_{p}^{\\nu} e_{q}^{\\rho}\n       ( R_{\\mu\\nu}^{q r} e_{r}^{\\mu} - 1/2 e^{q}_{\\nu} R_{\\sigma\\lambda}^{s t} e_{s}^{\\lambda} e_{t}^{\\sigma} );\ndistribute(eins)\nsubstitute(eins, $e^{q}_{\\nu} e_{q}^{\\rho} -> \\delta_{\\nu}^{\\rho}$)\neliminate_kronecker(eins)\nsort_product(eins)\ncanonicalise(eins)\nrename_dummies(eins);"
		},
		{
			"cell_id": 4557488290435542420,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 4557488290435542420,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "The difference with the result of the variation vanishes:"
				}
			],
			"hidden": true,
			"source": "The difference with the result of the variation vanishes:"
		},
		{
			"cell_id": 1993750131607482182,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 2316076825893082040,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 8747016987201557036,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "0"
						}
					],
					"source": "\\begin{dmath*}{}0\\,\\end{dmath*}"
				},
				{
					"cell_id": 1901648431917287354,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 6261039697809394423,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "0"
						}
					],
					"source": "\\begin{dmath*}{}0\\,\\end{dmath*}"
				}
			],
			"source": "chk2:= @(dL2) - @(eins);\ncanonicalise(chk2)\nrename_dummies(chk2)\ncollect_terms(chk2);"
		},
		{
			"cell_id": 4436317864282661553,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 4436317864282661553,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "Only the antisymmetry of $R_{\\mu\\nu}{}^{mn}$ in both index pairs was used here. The pair\nexchange symmetry does not hold, because the connection $\\omega(e,\\psi)$ has torsion."
				}
			],
			"hidden": true,
			"source": "Only the antisymmetry of $R_{\\mu\\nu}{}^{mn}$ in both index pairs was used here. The pair\nexchange symmetry does not hold, because the connection $\\omega(e,\\psi)$ has torsion."
		},
		{
			"cell_id": 5394927797007602772,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 5394927797007602772,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "\\subsection*{Variation of the gravitini}\n\nThe gravitino appears twice in $\\mathcal{L}^{(3/2)}$, so varying it gives two terms:\none with $\\delta\\psi_\\rho = D_\\rho\\epsilon$ and one with\n$\\delta\\bar\\psi_\\mu = \\overline{D_\\mu\\epsilon}$. We will need to integrate by parts,\nso this time we vary the action rather than the Lagrangian density."
				}
			],
			"hidden": true,
			"source": "\\subsection*{Variation of the gravitini}\n\nThe gravitino appears twice in $\\mathcal{L}^{(3/2)}$, so varying it gives two terms:\none with $\\delta\\psi_\\rho = D_\\rho\\epsilon$ and one with\n$\\delta\\bar\\psi_\\mu = \\overline{D_\\mu\\epsilon}$. We will need to integrate by parts,\nso this time we vary the action rather than the Lagrangian density."
		},
		{
			"cell_id": 3565623139165936875,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 14605065890195803480,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 18166838190367024641,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\psi_{\\mu} -> D_{\\mu}(\\epsilon)"
						}
					],
					"source": "\\begin{dmath*}{}\\psi_{\\mu} \\rightarrow D_{\\mu}{\\epsilon}\\end{dmath*}"
				},
				{
					"cell_id": 13400931838330165757,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 6093531459537607664,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": " -  1/2 \\int{e \\bar{\\psi_{\\mu}} \\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho}}{x}"
						}
					],
					"source": "\\begin{dmath*}{} - \\frac{1}{2}\\,\\int e \\bar{\\psi_{\\mu}} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\,\\,{\\rm d}x\\end{dmath*}"
				},
				{
					"cell_id": 320729682428195721,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 17337712561506479778,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": " -  1/2 \\int{e \\bar{D_{\\mu}(\\epsilon)} \\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} + e \\bar{\\psi_{\\mu}} \\Gamma^{m n p} D_{\\nu}(D_{\\rho}(\\epsilon)) e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho}}{x}"
						}
					],
					"source": "\\begin{dmath*}{} - \\frac{1}{2}\\,\\int \\left(e \\bar{D_{\\mu}{\\epsilon}} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{}+e \\bar{\\psi_{\\mu}} \\Gamma^{m n p} D_{\\nu}{D_{\\rho}{\\epsilon}} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\right)\\,\\,{\\rm d}x\\end{dmath*}"
				}
			],
			"source": "dpsi:= { \\psi_{\\mu} -> D_{\\mu}{\\epsilon} };\ndL32:= \\int{ @(L32) }{x};\nvary(dL32, dpsi);"
		},
		{
			"cell_id": 6629919722201498908,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 6629919722201498908,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "We handle the two terms one at a time, using \\verb|zoom| to hide the other one.\nIn the first term the two derivatives in $D_\\nu D_\\rho\\epsilon$ are antisymmetrised by\n$\\Gamma^{mnp}e_n{}^\\nu e_p{}^\\rho$, so we can replace them by half the commutator.\n$D_\\mu$ contains no Christoffel connection, so no torsion term appears, and the curvature\ncheck at the top gives $D_\\nu D_\\rho\\epsilon \\to \\tfrac18 R_{\\nu\\rho}{}^{mn}\\Gamma_{mn}\\epsilon$\n(vN~1.7 eq.~(3))."
				}
			],
			"hidden": true,
			"source": "We handle the two terms one at a time, using \\verb|zoom| to hide the other one.\nIn the first term the two derivatives in $D_\\nu D_\\rho\\epsilon$ are antisymmetrised by\n$\\Gamma^{mnp}e_n{}^\\nu e_p{}^\\rho$, so we can replace them by half the commutator.\n$D_\\mu$ contains no Christoffel connection, so no torsion term appears, and the curvature\ncheck at the top gives $D_\\nu D_\\rho\\epsilon \\to \\tfrac18 R_{\\nu\\rho}{}^{mn}\\Gamma_{mn}\\epsilon$\n(vN~1.7 eq.~(3))."
		},
		{
			"cell_id": 6561522359076015574,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 3562831775847886110,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 17841479548773612130,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": " -  1/2 \\int{ ...  + e \\bar{\\psi_{\\mu}} \\Gamma^{m n p} D_{\\nu}(D_{\\rho}(\\epsilon)) e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho}}{x}"
						}
					],
					"source": "\\begin{dmath*}{} - \\frac{1}{2}\\,\\int \\left( \\ldots \\discretionary{}{}{}+e \\bar{\\psi_{\\mu}} \\Gamma^{m n p} D_{\\nu}{D_{\\rho}{\\epsilon}} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\right)\\,\\,{\\rm d}x\\end{dmath*}"
				}
			],
			"source": "zoom(dL32, $D_{\\nu}{D_{\\rho}{\\epsilon}} Q??$);"
		},
		{
			"cell_id": 3850742930865771165,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 13508038502925302195,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 15058846856952698914,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": " -  1/2 \\int{e \\bar{D_{\\mu}(\\epsilon)} \\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} +  1/8 e \\bar{\\psi_{\\mu}} \\Gamma^{m n p} R_{\\nu \\rho}^{q r} \\Gamma_{q r} \\epsilon e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho}}{x}"
						}
					],
					"source": "\\begin{dmath*}{} - \\frac{1}{2}\\,\\int \\left(e \\bar{D_{\\mu}{\\epsilon}} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{}+\\frac{1}{8}\\,e \\bar{\\psi_{\\mu}} \\Gamma^{m n p} R_{\\nu \\rho}\\,^{q r} \\Gamma_{q r} \\epsilon e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\right)\\,\\,{\\rm d}x\\end{dmath*}"
				}
			],
			"source": "substitute(dL32, $D_{\\nu}{D_{\\rho}{\\epsilon}} -> 1/8 R_{\\nu\\rho}^{m n} \\Gamma_{m n} \\epsilon$)\nunzoom(dL32);"
		},
		{
			"cell_id": 8520076391040655467,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 8520076391040655467,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "In the second term we use $\\overline{D_\\mu\\epsilon} = D_\\mu\\bar\\epsilon\n= \\partial_\\mu\\bar\\epsilon - \\tfrac14\\bar\\epsilon\\,\\omega_\\mu{}^{mn}\\Gamma_{mn}$ (vN~1.7 eq.~(8)),\nand integrate by parts to remove the derivative from $\\bar\\epsilon$. The total derivative is\nthe derivative of a Lorentz scalar, so $D_\\mu=\\partial_\\mu$ on it and we may drop it."
				}
			],
			"hidden": true,
			"source": "In the second term we use $\\overline{D_\\mu\\epsilon} = D_\\mu\\bar\\epsilon\n= \\partial_\\mu\\bar\\epsilon - \\tfrac14\\bar\\epsilon\\,\\omega_\\mu{}^{mn}\\Gamma_{mn}$ (vN~1.7 eq.~(8)),\nand integrate by parts to remove the derivative from $\\bar\\epsilon$. The total derivative is\nthe derivative of a Lorentz scalar, so $D_\\mu=\\partial_\\mu$ on it and we may drop it."
		},
		{
			"cell_id": 3914279901723729777,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 15494503682393194261,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 138043172718569,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": " -  1/2 \\int{e \\bar{D_{\\mu}(\\epsilon)} \\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} +  ... }{x}"
						}
					],
					"source": "\\begin{dmath*}{} - \\frac{1}{2}\\,\\int \\left(e \\bar{D_{\\mu}{\\epsilon}} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{}+ \\ldots \\right)\\,\\,{\\rm d}x\\end{dmath*}"
				}
			],
			"source": "zoom(dL32, $\\bar{D_{\\mu}{\\epsilon}} Q??$);"
		},
		{
			"cell_id": 7934074016821202288,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 14244342443766833290,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 9256832769423123039,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": " -  1/2 \\int{-D_{\\mu}(e) \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho}-e \\bar{\\epsilon} D_{\\mu}(\\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho}) +  ... }{x}"
						}
					],
					"source": "\\begin{dmath*}{} - \\frac{1}{2}\\,\\int \\left(-\\,D_{\\mu}{e} \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{}-\\,e \\bar{\\epsilon} D_{\\mu}\\left(\\Gamma^{m n p} D_{\\nu}{\\psi_{\\rho}} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\right)\\discretionary{}{}{}+ \\ldots \\right)\\,\\,{\\rm d}x\\end{dmath*}"
				}
			],
			"source": "substitute(dL32, $\\bar{D_{\\mu}{\\epsilon}} -> D_{\\mu}{\\bar{\\epsilon}}$)\nintegrate_by_parts(dL32, $\\bar{\\epsilon}$);"
		},
		{
			"cell_id": 2848427937656661291,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 2848427937656661291,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "The derivative $D_\\mu$ now acts on the determinant, the inverse vielbeine, the gamma matrix\nand $D_\\nu\\psi_\\rho$. A gamma matrix with flat indices is covariantly constant. The derivatives\nof the determinant and of the inverse vielbeine can all be written in terms of $D_\\mu e^q{}_\\lambda$.\nThis is not zero, because $D_\\mu$ contains only the spin connection (see vN~1.4 below eq.~(3)):\n\\begin{equation*}\nD_\\mu e = e\\, e_q{}^\\lambda D_\\mu e^q{}_\\lambda\\,,\\qquad\nD_\\mu e_m{}^\\nu = - e_m{}^\\lambda (D_\\mu e^q{}_\\lambda)\\, e_q{}^\\nu\\,.\n\\end{equation*}\nThe two covariant derivatives on the gravitino are antisymmetrised again, so they also\nbecome a curvature, $D_\\mu D_\\nu\\psi_\\rho \\to \\tfrac18 R_{\\mu\\nu}{}^{mn}\\Gamma_{mn}\\psi_\\rho$."
				}
			],
			"hidden": true,
			"source": "The derivative $D_\\mu$ now acts on the determinant, the inverse vielbeine, the gamma matrix\nand $D_\\nu\\psi_\\rho$. A gamma matrix with flat indices is covariantly constant. The derivatives\nof the determinant and of the inverse vielbeine can all be written in terms of $D_\\mu e^q{}_\\lambda$.\nThis is not zero, because $D_\\mu$ contains only the spin connection (see vN~1.4 below eq.~(3)):\n\\begin{equation*}\nD_\\mu e = e\\, e_q{}^\\lambda D_\\mu e^q{}_\\lambda\\,,\\qquad\nD_\\mu e_m{}^\\nu = - e_m{}^\\lambda (D_\\mu e^q{}_\\lambda)\\, e_q{}^\\nu\\,.\n\\end{equation*}\nThe two covariant derivatives on the gravitino are antisymmetrised again, so they also\nbecome a curvature, $D_\\mu D_\\nu\\psi_\\rho \\to \\tfrac18 R_{\\mu\\nu}{}^{mn}\\Gamma_{mn}\\psi_\\rho$."
		},
		{
			"cell_id": 8250698898867225351,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 11626118661314278147,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
