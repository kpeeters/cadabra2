		{
			"cell_id": 2610188153016264325,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 2610188153016264325,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "\\subsection*{The curvature terms}\n\nWe add the curvature terms of the two gravitino variations and simplify the gamma matrix\nalgebra. The terms with five gamma matrices vanish in four dimensions. To compare the two\npieces, all spinor bilinears are written with $\\bar\\epsilon$ on the left, using the Majorana\nflip relations (vN~1.7 eq.~(5)). The terms with three gamma matrices then cancel, and what\nremains is"
				}
			],
			"hidden": true,
			"source": "\\subsection*{The curvature terms}\n\nWe add the curvature terms of the two gravitino variations and simplify the gamma matrix\nalgebra. The terms with five gamma matrices vanish in four dimensions. To compare the two\npieces, all spinor bilinears are written with $\\bar\\epsilon$ on the left, using the Majorana\nflip relations (vN~1.7 eq.~(5)). The terms with three gamma matrices then cancel, and what\nremains is"
		},
		{
			"cell_id": 5592596818841507801,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 13203090216722834002,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 8112226056000670340,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": " 1/16 e \\bar{\\epsilon} \\Gamma^{m n p} R_{\\mu \\nu}^{q r} \\Gamma_{q r} \\psi_{\\rho} e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} -  1/16 e \\bar{\\psi_{\\mu}} \\Gamma^{m n p} R_{\\nu \\rho}^{q r} \\Gamma_{q r} \\epsilon e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho}"
						}
					],
					"source": "\\begin{dmath*}{}\\frac{1}{16}\\,e \\bar{\\epsilon} \\Gamma^{m n p} R_{\\mu \\nu}\\,^{q r} \\Gamma_{q r} \\psi_{\\rho} e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\discretionary{}{}{} - \\frac{1}{16}\\,e \\bar{\\psi_{\\mu}} \\Gamma^{m n p} R_{\\nu \\rho}\\,^{q r} \\Gamma_{q r} \\epsilon e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\end{dmath*}"
				},
				{
					"cell_id": 13112203270524685386,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 16139646407355581323,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": " 1/2 R_{\\mu \\nu}^{m n} \\bar{\\epsilon} \\Gamma^{p} \\psi_{\\rho} e e_{m}^{\\mu} e_{n}^{\\rho} e_{p}^{\\nu} -  1/4 R_{\\mu \\nu}^{m n} \\bar{\\epsilon} \\Gamma^{p} \\psi_{\\rho} e e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho}"
						}
					],
					"source": "\\begin{dmath*}{}\\frac{1}{2}\\,R_{\\mu \\nu}\\,^{m n} \\bar{\\epsilon} \\Gamma^{p} \\psi_{\\rho} e e_{m}\\,^{\\mu} e_{n}\\,^{\\rho} e_{p}\\,^{\\nu}\\discretionary{}{}{} - \\frac{1}{4}\\,R_{\\mu \\nu}\\,^{m n} \\bar{\\epsilon} \\Gamma^{p} \\psi_{\\rho} e e_{m}\\,^{\\mu} e_{n}\\,^{\\nu} e_{p}\\,^{\\rho}\\end{dmath*}"
				}
			],
			"source": "curv:= @(curv1) + @(dpsiu);\ndistribute(curv)\nsort_product(curv)\njoin_gamma(curv)\ndistribute(curv)\neliminate_kronecker(curv)\nsort_spinors(curv)\nsort_product(curv)\ncanonicalise(curv)\nrename_dummies(curv)\ncollect_terms(curv);"
		},
		{
			"cell_id": 4678480926702719961,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
