							"cell_id": 5814671559718603462,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "D_{\\mu}(A??) -> \\partial_{\\mu}(A??) +  1/4 \\omega_{\\mu}^{m n} \\Gamma_{m n} A??"
						}
					],
					"source": "\\begin{dmath*}{}D_{\\mu}\\left(A??\\right) \\rightarrow \\partial_{\\mu}\\left(A??\\right)\\discretionary{}{}{}+\\frac{1}{4}\\,\\omega_{\\mu}\\,^{m n} \\Gamma_{m n} A??\\end{dmath*}"
				},
				{
					"cell_id": 4002836190808742296,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 3246966802452409535,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "D_{\\mu}(D_{\\nu}(\\psi_{\\rho}))-D_{\\nu}(D_{\\mu}(\\psi_{\\rho}))"
						}
					],
					"source": "\\begin{dmath*}{}D_{\\mu}{D_{\\nu}{\\psi_{\\rho}}}\\discretionary{}{}{}-\\,D_{\\nu}{D_{\\mu}{\\psi_{\\rho}}}\\end{dmath*}"
				}
			],
			"source": "covd:= D_{\\mu}{A??} -> \\partial_{\\mu}{A??} + 1/4 \\omega_{\\mu}^{m n} \\Gamma_{m n} A??;\ncomm:= D_{\\mu}{D_{\\nu}{\\psi_{\\rho}}} - D_{\\nu}{D_{\\mu}{\\psi_{\\rho}}};"
		},
		{
			"cell_id": 6471960420569254721,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 16128203795813409030,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 13597728067552588782,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": " 1/4 \\Gamma_{m n} \\partial_{\\mu}(\\omega_{\\nu}^{m n}) \\psi_{\\rho} -  1/2 \\Gamma^{m n} \\delta^{p q} \\omega_{\\mu m p} \\omega_{\\nu n q} \\psi_{\\rho} -  1/4 \\Gamma_{m n} \\partial_{\\nu}(\\omega_{\\mu}^{m n}) \\psi_{\\rho}"
						}
					],
					"source": "\\begin{dmath*}{}\\frac{1}{4}\\,\\Gamma_{m n} \\partial_{\\mu}{\\omega_{\\nu}\\,^{m n}} \\psi_{\\rho}\\discretionary{}{}{} - \\frac{1}{2}\\,\\Gamma^{m n} \\delta^{p q} \\omega_{\\mu m p} \\omega_{\\nu n q} \\psi_{\\rho}\\discretionary{}{}{} - \\frac{1}{4}\\,\\Gamma_{m n} \\partial_{\\nu}{\\omega_{\\mu}\\,^{m n}} \\psi_{\\rho}\\end{dmath*}"
				}
			],
			"source": "substitute(comm, covd, repeat=True)\ndistribute(comm)\nproduct_rule(comm)\ndistribute(comm)\nsort_product(comm)\njoin_gamma(comm)\ndistribute(comm)\nunwrap(comm)\ncanonicalise(comm)\nrename_dummies(comm);"
		},
