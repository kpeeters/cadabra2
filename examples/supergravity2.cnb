							"source": " -  1/2 \\int{-e e_{q}^{\\lambda} D_{\\mu}(e^{q}_{\\lambda}) \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} -  1/8 e \\bar{\\epsilon} \\Gamma^{m n p} R_{\\mu \\nu}^{q r} \\Gamma_{q r} \\psi_{\\rho} e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} + e \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e_{m}^{\\lambda} D_{\\mu}(e^{q}_{\\lambda}) e_{q}^{\\mu} e_{n}^{\\nu} e_{p}^{\\rho} + e \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e_{m}^{\\mu} e_{n}^{\\lambda} D_{\\mu}(e^{q}_{\\lambda}) e_{q}^{\\nu} e_{p}^{\\rho} + e \\bar{\\epsilon} \\Gamma^{m n p} D_{\\nu}(\\psi_{\\rho}) e_{m}^{\\mu} e_{n}^{\\nu} e_{p}^{\\lambda} D_{\\mu}(e^{q}_{\\lambda}) e_{q}^{\\rho} +  ... }{x}"
