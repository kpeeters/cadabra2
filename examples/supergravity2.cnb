					"source": "\\begin{dmath*}{}D_{\\mu}{e^{q}\\,_{\\nu}} \\rightarrow C_{\\mu \\nu}\\,^{q}\\discretionary{}{}{}+\\frac{1}{4}\\,\\bar{\\psi_{\\mu}} \\Gamma^{q} \\psi_{\\nu}\\end{dmath*}"
				}
