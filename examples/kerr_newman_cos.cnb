					"source": "\\begin{dmath*}{}Rsq = \\frac{4\\,{Q}^{4\\,}}{{\\left({a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{4\\,}}\\end{dmath*}"
				}
