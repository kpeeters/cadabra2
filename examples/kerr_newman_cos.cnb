							"cell_id": 13841083710432003102,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "R_{\\sigma \\nu} = \\components_{\\nu \\sigma}({{t, t} = -(Q)**2 (2M r + (a)**2 (y)**2-2(a)**2-(r)**2-(Q)**2) ((a)**2 (y)**2 + (r)**2)**(-3), {t, \\phi} = a (Q)**2 (y-1) (y + 1) (-2M r + 2(a)**2 + 2(r)**2 + (Q)**2) ((a)**2 (y)**2 + (r)**2)**(-3), {\\phi, t} = a (Q)**2 (y-1) (y + 1) (-2M r + 2(a)**2 + 2(r)**2 + (Q)**2) ((a)**2 (y)**2 + (r)**2)**(-3), {r, r} = -(Q)**2 (((a)**2 (y)**2 + (r)**2) (-2M r + (a)**2 + (r)**2 + (Q)**2))**(-1), {y, y} = -(Q)**2 ((y-1) (y + 1) ((a)**2 (y)**2 + (r)**2))**(-1), {\\phi, \\phi} = (Q)**2 (y-1) (y + 1) (-2M (a)**2 r (y)**2 + 2M (a)**2 r + (a)**4 (y)**2-2(a)**4 + (a)**2 (r)**2 (y)**2-3(a)**2 (r)**2 + (a)**2 (Q)**2 (y)**2-(a)**2 (Q)**2-(r)**4) ((a)**2 (y)**2 + (r)**2)**(-3)})"
						}
					],
					"source": "\\begin{dmath*}{}R_{\\sigma \\nu} = \\square{}_{\\nu}{}_{\\sigma}\\left\\{\\begin{aligned}\\square{}_{t}{}_{t}& = -\\frac{{Q}^{2\\,} \\left(2\\,M r\\discretionary{}{}{}+{a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}-2\\,{a}^{2\\,}\\discretionary{}{}{}-\\,{r}^{2\\,}\\discretionary{}{}{}-\\,{Q}^{2\\,}\\right)}{{\\left({a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{3\\,}}\\\\[-.5ex]\n\\square{}_{t}{}_{\\phi}& = \\square{}_{\\phi}{}_{t} = \\frac{a {Q}^{2\\,} \\left(y\\discretionary{}{}{}-\\,1\\right) \\left(y\\discretionary{}{}{}+1\\right) \\left(-2\\,M r\\discretionary{}{}{}+2\\,{a}^{2\\,}\\discretionary{}{}{}+2\\,{r}^{2\\,}\\discretionary{}{}{}+{Q}^{2\\,}\\right)}{{\\left({a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{3\\,}}\\\\[-.5ex]\n\\square{}_{r}{}_{r}& = -\\frac{{Q}^{2\\,}}{\\left({a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right) \\left(-2\\,M r\\discretionary{}{}{}+{a}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\discretionary{}{}{}+{Q}^{2\\,}\\right)}\\\\[-.5ex]\n\\square{}_{y}{}_{y}& = -\\frac{{Q}^{2\\,}}{\\left(y\\discretionary{}{}{}-\\,1\\right) \\left(y\\discretionary{}{}{}+1\\right) \\left({a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}\\\\[-.5ex]\n\\square{}_{\\phi}{}_{\\phi}& = \\frac{{Q}^{2\\,} \\left(y\\discretionary{}{}{}-\\,1\\right) \\left(y\\discretionary{}{}{}+1\\right) \\left(-2\\,M {a}^{2\\,} r {y}^{2\\,}\\discretionary{}{}{}+2\\,M {a}^{2\\,} r\\discretionary{}{}{}+{a}^{4\\,} {y}^{2\\,}\\discretionary{}{}{}-2\\,{a}^{4\\,}\\discretionary{}{}{}+{a}^{2\\,} {r}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}-3\\,{a}^{2\\,} {r}^{2\\,}\\discretionary{}{}{}+{a}^{2\\,} {Q}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}-\\,{a}^{2\\,} {Q}^{2\\,}\\discretionary{}{}{}-\\,{r}^{4\\,}\\right)}{{\\left({a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{3\\,}}\\\\[-.5ex]\n\\end{aligned}\\right\\}\n\\end{dmath*}"
				}
