			"cells": [
				{
					"cell_id": 5659879218128378383,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "Kerr-Newman is not a vacuum solution: the Ricci tensor equals $8\\pi$ times the\nenergy-momentum tensor of the electromagnetic field, and is proportional to\n$Q^2$."
				}
			],
			"hidden": true,
			"source": "Kerr-Newman is not a vacuum solution: the Ricci tensor equals $8\\pi$ times the\nenergy-momentum tensor of the electromagnetic field, and is proportional to\n$Q^2$."
