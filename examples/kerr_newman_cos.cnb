\,}\\discretionary{}{}{}-\\,{a}^{2\\,} {Q}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,} {Q}^{2\\,}\\right)}{{\\left({a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{4\\,}}\\\\[-.5ex]\n\\square{}_{\\phi}{}_{\\phi}{}^{t}{}_{t}& = -\\frac{\\left(y\\discretionary{}{}{}-\\,1\\right) \\left(y\\discretionary{}{}{}+1\\right) \\left(3\\,M {a}^{2\\,} r {y}^{2\\,}\\discretionary{}{}{}-\\,M {r}^{3\\,}\\discretionary{}{}{}-\\,{a}^{2\\,} {Q}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,} {Q}^{2\\,}\\right) \\left(-2\\,M {a}^{2\\,} r {y}^{2\\,}\\discretionary{}{}{}+2\\,M {a}^{2\\,} r\\discretionary{}{}{}+{a}^{4\\,} {y}^{2\\,}\\discretionary{}{}{}+{a}^{2\\,} {r}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{a}^{2\\,} {r}^{2\\,}\\discretionary{}{}{}+{a}^{2\\,} {Q}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}-\\,{a}^{2\\,} {Q}^{2\\,}\\discretionary{}{}{}+{r}^{4\\,}\\right)}{{\\left({a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{4\\,}}\\\\[-.5ex]\n\\square{}_{\\phi}{}_{t}{}^{\\phi}{}_{t}& = \\frac{\\left(-2\\,M r\\discretionary{}{}{}+{a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\discretionary{}{}{}+{Q}^{2\\,}\\right) \\left(3\\,M {a}^{2\\,} r {y}^{2\\,}\\discretionary{}{}{}-\\,M {r}^{3\\,}\\discretionary{}{}{}-\\,{a}^{2\\,} {Q}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,} {Q}^{2\\,}\\right)}{{\\left({a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{4\\,}}\\\\[-.5ex]\n\\square{}_{t}{}_{r}{}^{y}{}_{\\phi}& = \\frac{a y \\left(y\\discretionary{}{}{}-\\,1\\right) \\left(y\\discretionary{}{}{}+1\\right) \\left(M {a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}-3\\,M {r}^{2\\,}\\discretionary{}{}{}+2\\,r {Q}^{2\\,}\\right)}{{\\left({a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{3\\,}}\\\\[-.5ex]\n\\square{}_{t}{}_{y}{}^{r}{}_{\\phi}& = \\frac{a y \\left(M {a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}-3\\,M {r}^{2\\,}\\discretionary{}{}{}+2\\,r {Q}^{2\\,}\\right) \\left(-2\\,M r\\discretionary{}{}{}+{a}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\discretionary{}{}{}+{Q}^{2\\,}\\right)}{{\\left({a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{3\\,}}\\\\[-.5ex]\n\\square{}_{\\phi}{}_{r}{}^{y}{}_{t}& = -\\frac{a y \\left(y\\discretionary{}{}{}-\\,1\\right) \\left(y\\discretionary{}{}{}+1\\right) \\left(M {a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}-3\\,M {r}^{2\\,}\\discretionary{}{}{}+2\\,r {Q}^{2\\,}\\right)}{{\\left({a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{3\\,}}\\\\[-.5ex]\n\\square{}_{\\phi}{}_{y}{}^{r}{}_{t}& = -\\frac{a y \\left(M {a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}-3\\,M {r}^{2\\,}\\discretionary{}{}{}+2\\,r {Q}^{2\\,}\\right) \\left(-2\\,M r\\discretionary{}{}{}+{a}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\discretionary{}{}{}+{Q}^{2\\,}\\right)}{{\\left({a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{3\\,}}\\\\[-.5ex]\n\\end{aligned}\\right\\}\n\\end{dmath*}"
				}
			],
			"source": "rm:= R^{\\rho}_{\\sigma\\mu\\nu} = \\partial_{\\mu}{\\Gamma^{\\rho}_{\\nu\\sigma}}\n                                  -\\partial_{\\nu}{\\Gamma^{\\rho}_{\\mu\\sigma}}\n                                  +\\Gamma^{\\rho}_{\\mu\\lambda} \\Gamma^{\\lambda}_{\\nu\\sigma}\n                                  -\\Gamma^{\\rho}_{\\nu\\lambda} \\Gamma^{\\lambda}_{\\mu\\sigma}:\nsubstitute(rm, ch)\nevaluate(rm, ss, rhsonly=True, simplify=False)\ntrigrat(rm);"
		},
		{
