							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "K = 8(6(M)**2 (r)**2-12M r (Q)**2 + 7(Q)**4) (r)**(-8)"
						}
					],
					"source": "\\begin{dmath*}{}K = \\frac{8\\,\\left(6\\,{M}^{2\\,} {r}^{2\\,}\\discretionary{}{}{}-12\\,M r {Q}^{2\\,}\\discretionary{}{}{}+7\\,{Q}^{4\\,}\\right)}{{r}^{8\\,}}\\end{dmath*}"
