					"cells": [
						{
							"cell_id": 14654089782645186145,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "K = -8(6(M)**2 (a)**6 (y)**6-90(M)**2 (a)**4 (r)**2 (y)**4 + 90(M)**2 (a)**2 (r)**4 (y)**2-6(M)**2 (r)**6 + 60M (a)**4 r (Q)**2 (y)**4-120M (a)**2 (r)**3 (Q)**2 (y)**2 + 12M (r)**5 (Q)**2-7(a)**4 (Q)**4 (y)**4 + 34(a)**2 (r)**2 (Q)**4 (y)**2-7(r)**4 (Q)**4) ((a)**2 (y)**2 + (r)**2)**(-6)"
						}
					],
					"source": "\\begin{dmath*}{}K = -\\frac{8\\,\\left(6\\,{M}^{2\\,} {a}^{6\\,} {y}^{6\\,}\\discretionary{}{}{}-90\\,{M}^{2\\,} {a}^{4\\,} {r}^{2\\,} {y}^{4\\,}\\discretionary{}{}{}+90\\,{M}^{2\\,} {a}^{2\\,} {r}^{4\\,} {y}^{2\\,}\\discretionary{}{}{}-6\\,{M}^{2\\,} {r}^{6\\,}\\discretionary{}{}{}+60\\,M {a}^{4\\,} r {Q}^{2\\,} {y}^{4\\,}\\discretionary{}{}{}-120\\,M {a}^{2\\,} {r}^{3\\,} {Q}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+12\\,M {r}^{5\\,} {Q}^{2\\,}\\discretionary{}{}{}-7\\,{a}^{4\\,} {Q}^{4\\,} {y}^{4\\,}\\discretionary{}{}{}+34\\,{a}^{2\\,} {r}^{2\\,} {Q}^{4\\,} {y}^{2\\,}\\discretionary{}{}{}-7\\,{r}^{4\\,} {Q}^{4\\,}\\right)}{{\\left({a}^{2\\,} {y}^{2\\,}\\discretionary{}{}{}+{r}^{2\\,}\\right)}^{6\\,}}\\end{dmath*}"
				}
			],
			"source": "K:= K = R^{\\mu}_{\\nu\\rho\\sigma} R^{\\lambda}_{\\kappa\\gamma\\chi}\n           g_{\\mu\\lambda} g^{\\nu\\kappa} g^{\\rho\\gamma} g^{\\sigma\\chi}:\nsubstitute(K, rm)\nevaluate(K, ss, rhsonly=True, simplify=False)\ntrigrat(K);"
		},
		{
			"cell_id": 1559725937500652010,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 2054955470655777465,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "This agrees with Henry's result,\n\\begin{equation*}\nK = \\frac{8}{\\Sigma^6}\\Big[6M^2\\left(r^6 - 15a^2r^4y^2 + 15a^4r^2y^4 - a^6y^6\\right)\n    - 12MQ^2r\\left(r^4 - 10a^2r^2y^2 + 5a^4y^4\\right)\\\\\n    + Q^4\\left(7r^4 - 34a^2r^2y^2 + 7a^4y^4\\right)\\Big]\\,.\n\\end{equation*}\nFor $Q=0$ it reduces to the Kerr result, and for $a=0$ to the\nReissner-Nordstr\\\"om value $8(6M^2r^2 - 12MQ^2r + 7Q^4)/r^8$:"
				}
			],
			"hidden": true,
			"source": "This agrees with Henry's result,\n\\begin{equation*}\nK = \\frac{8}{\\Sigma^6}\\Big[6M^2\\left(r^6 - 15a^2r^4y^2 + 15a^4r^2y^4 - a^6y^6\\right)\n    - 12MQ^2r\\left(r^4 - 10a^2r^2y^2 + 5a^4y^4\\right)\\\\\n    + Q^4\\left(7r^4 - 34a^2r^2y^2 + 7a^4y^4\\right)\\Big]\\,.\n\\end{equation*}\nFor $Q=0$ it reduces to the Kerr result, and for $a=0$ to the\nReissner-Nordstr\\\"om value $8(6M^2r^2 - 12MQ^2r + 7Q^4)/r^8$:"
		},
