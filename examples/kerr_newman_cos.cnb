							"cell_type": "input_form",
							"source": "K = R^{\\mu}_{\\nu \\rho \\sigma} R^{\\lambda}_{\\kappa \\gamma \\chi} g_{\\mu \\lambda} g^{\\nu \\kappa} g^{\\rho \\gamma} g^{\\sigma \\chi}"
