							"cell_id": 133093235326950876,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": " -  1/2 \\int{\\delta(\\phi) (-2\\partial^{\\mu}_{\\mu}(\\phi) + 2\\phi (m)**2)}{x}"
						}
					],
					"source": "\\begin{dmath*}{} - \\frac{1}{2}\\,\\int \\delta\\left(\\phi\\right) \\left(-2\\,\\partial^{\\mu}\\,_{\\mu}{\\phi}\\discretionary{}{}{}+2\\,\\phi {m}^{2\\,}\\right)\\,\\,{\\rm d}x\\end{dmath*}"
				}
			],
			"source": "factor_out(_, $\\delta{\\phi}$);"
