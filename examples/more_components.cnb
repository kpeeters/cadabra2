					"cell_id": 272916513600514445,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"source": "\\begin{dmath*}{}\\text{Property Indices(position=free) attached to~}\\left[i, \\discretionary{}{}{}j, \\discretionary{}{}{}k\\right].\\end{dmath*}"
				},
				{
					"cell_id": 18246880220944946203,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"source": "\\begin{dmath*}{}\\text{Property Integer attached to~}\\left[i, \\discretionary{}{}{}j, \\discretionary{}{}{}k\\right].\\end{dmath*}"
				}
			],
			"source": "\\epsilon{#}::EpsilonTensor;\n{i,j,k}::Indices;\n{i,j,k}::Integer(1..3);"
		},
		{
			"cell_id": 748441947799723436,
			"cell_origin": "client",
			"cell_type": "latex",
			"cells": [
				{
					"cell_id": 11721239948184253650,
					"cell_origin": "client",
					"cell_type": "latex_view",
					"source": "Writing out the components of $\\vec{a}\\times \\vec{v} + \\vec{a} (\\vec{a}\\cdot\\vec{v})$: "
				}
			],
			"hidden": true,
			"source": "Writing out the components of $\\vec{a}\\times \\vec{v} + \\vec{a} (\\vec{a}\\cdot\\vec{v})$: "
		},
		{
			"cell_id": 15213398570971969176,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 12641417569625421506,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 5270850658071664934,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\epsilon_{i j k} a_{j} v_{k} + a_{i} a_{j} v_{j}"
						}
					],
					"source": "\\begin{dmath*}{}\\epsilon_{i j k} a_{j} v_{k}\\discretionary{}{}{}+a_{i} a_{j} v_{j}\\end{dmath*}"
				}
			],
			"source": "ex:= \\epsilon_{i j k} a_{j} v_{k} + a_{i} a_{j} v_{j};"
		},
		{
			"cell_id": 17272185679405116573,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 612091638952054217,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 6709572859044942149,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "{a_{1} = 1, a_{2} = 1, a_{3} = 1}"
						}
					],
					"source": "\\begin{dmath*}{}\\left[a_{1} = 1, \\discretionary{}{}{}a_{2} = 1, \\discretionary{}{}{}a_{3} = 1\\right]\\end{dmath*}"
				}
			],
			"source": "rl:= { a_{1}=1, a_{2}=1, a_{3}=1 };"
		},
		{
			"cell_id": 4116361409689257985,
			"cell_origin": "client",
			"cell_type": "input",
			"cells": [
				{
					"cell_id": 3956066262085207726,
					"cell_origin": "server",
					"cell_type": "latex_view",
					"cells": [
						{
							"cell_id": 9908391600522522786,
							"cell_origin": "server",
							"cell_type": "input_form",
							"source": "\\components_{i}({{1} = 2v_{3} + v_{1}, {2} = 2v_{1} + v_{2}, {3} = 2v_{2} + v_{3}})"
						}
					],
					"source": "\\begin{dmath*}{}\\square{}_{i}\\left\\{\\begin{aligned}\\square{}_{1}& = 2v_{3}\\discretionary{}{}{}+v_{1}\\\\[-.5ex]\n\\square{}_{2}& = 2v_{1}\\discretionary{}{}{}+v_{2}\\\\[-.5ex]\n\\square{}_{3}& = 2v_{2}\\discretionary{}{}{}+v_{3}\\\\[-.5ex]\n\\end{aligned}\\right.\n\\end{dmath*}"
				}
			],
			"source": "evaluate(ex, rl);"
		},
